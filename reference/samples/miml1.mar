; MI-logic of ML/I --- continued
; Part 2 -- Program sections
; Version of Aug 24 1971
; Updated 8th January 1985  R.D. Eager
; Updated 13th January 1986  R.D. Eager
;
	.SUBTITLE	Message text
	.PAGE
;
	.PSECT	PURE,LONG,SHR,NOWRT,NOEXE
;
MES1:	.ASCIC	\ aborted due to above error$$\
MES2:	.ASCIC	\$\
MES3:	.ASCIC	\ is illegal macro element\
MES4:	.ASCIC	\Label \
MES5:	.ASCIC	\ is multiply-defined\
MES6:	.ASCIC	\Illegal input character\
MES7:	.ASCIC	\Illegal macro name after warning\
MES8:	.ASCIC	\Process aborted for lack of storage\
MES9:	.ASCIC	\ possibly due to$\
MES10:	.ASCIC	\Arithmetic overflow\
MES11:	.ASCIC	\Argument \
MES12:	.ASCIC	\ has illegal value\
MES13:	.ASCIC	\System error$$\
MES14:	.ASCIC	\$$detected in$\
MES15:	.ASCIC	\ of \
MES16:	.ASCIC	\ with \
MES17:	.ASCIC	\no \
MES18:	.ASCIC	\arguments\
MES19:	.ASCIC	\  $  \
MES20:	.ASCIC	\)  \
MES21:	.ASCIC	\$called from$\
MES22:	.ASCIC	\lines \
MES23:	.ASCIC	\ to \
MES24:	.ASCIC	\argument \
MES25:	.ASCIC	\delimiter \
MES26:	.ASCIC	\ evaluated in$\
MES27:	.ASCIC	\source text$$$\
MES28:	.ASCIC	\$$$Error(s)$\
MES29:	.ASCIC	\(null)\
MES30:	.ASCIC	\(\
MES31:	.ASCIC	\)\
MES32:	.ASCIC	\  ---  \
MES33:	.ASCIC	\ \
MES34:	.ASCIC	\line \
MES35:	.ASCIC	\Delimiter \
MES36:	.ASCIC	\ or \
MES37:	.ASCIC	\ referenced\
MES38:	.ASCIC	\ in \
MES39:	.ASCIC	\ of current text not found$\
MES40:	.ASCIC	\stop\
MES41:	.ASCIC	\Stop\
MES42:	.ASCIC	\macro\
MES43:	.ASCIC	\Macro\
MES44:	.ASCIC	\warning\
MES45:	.ASCIC	\Warning\
MES46:	.ASCIC	\insert\
MES47:	.ASCIC	\Insert\
MES48:	.ASCIC	\skip\
MES49:	.ASCIC	\Skip\
MES50:	.ASCIC	\, viz \
MES51:	.ASCIC	\$$Version AJB$\
MES52:	.ASCIC	\s are$$\
MES53:	.ASCIC	\$$At end of process: \
MES54:	.ASCIC	\ line\
MES55:	.ASCIC	\s\
MES56:	.ASCIC	\, \
MES57:	.ASCIC	\ call\
MES58:	.ASCIC	\(SL)\
;
	.SUBTITLE	Main code
	.PAGE
;
	.PSECT	CODE,LONG,SHR,NOWRT
;
BEGIN:
;
	MOVL	SP,MDSPBASE
	MOVL	FFPT,R0

; Reserve ERBLOC,HASHTB,GHSHTB...
; ...and 10 permanent variables
	MOVL	R0,ETEMPT
	ADDL2	#28,R0
	MOVL	R0,TEMPT
	ADDL2	#44,R0
	MOVL	R0,PVARPT
	SUBL2	ETEMPT,R0
	BSBW	BUMPFF
	MOVL	#10,R0
	MOVL	R0,PVNUM
	MOVL	R0,@FFPT
	ADDL2	#4,FFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL1
	BRW	ERLSO
ZZL1:

	MOVL	LFPT,ENDPT
	MOVL	#7,GLBWSW
; Zeroise permanant variables
ZPLP:	ADDL2	#4,TEMPT
	CMPL	TEMPT,PVARPT
	BEQLU	SETMKS
	CLRL	@TEMPT
	BRB	ZPLP
; Set values of special markers
SETMKS:	MOVL	#CWITHS,TEMPT
	MOVL	@TEMPT,R0
	MOVL	R0,WTHSMK
	DECL	R0
	MOVL	R0,WITHMK
	DECL	R0
	MOVL	R0,EXCLMK
	DECL	R0
	MOVL	R0,SPCSMK
	MOVL	#1,R0
	MOVL	R0,NLSW
	MOVL	R0,LINECT
	CLRL	R0
	MOVL	R0,LABPT
	MOVL	R0,STOPPT
	MOVL	R0,TVARPT
	MOVL	R0,ARGPT
	MOVL	R0,OPLEV
	MOVL	R0,NESTLV
	MOVL	R0,SKIPLV
	MOVL	R0,INVOCT
	MOVL	R0,LEVEL
	MOVL	R0,TLINCT
	MOVL	R0,SKVAL
	MOVL	R0,BINDIC
	MOVL	R0,DBUGSW
	SUBL2	#4,LFPT
	MOVL	R0,@LFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL2
	BRW	ERLSO
ZZL2:

	MOVL	#GHSHTB,HASHPT
	BSBW	STKHSH
; Set limits on locals
	MOVL	HASHPT,R0
	ADDL2	#256,R0

	MOVL	R0,TEMPT
LIMLP:	MOVL	ENDPT,@TEMPT
	ADDL2	#4,TEMPT
	TSTL	@TEMPT
	BEQL	LIMLP
	MOVL	#KNREP,KNPT
; Start of logic -- Main scanning routine
	MOVL	PVARPT,R0
	MOVL	R0,FFPT
	ADDL2	#3,R0
	MOVL	R0,SPT
	MOVL	PVNUM,@FFPT
	ADDL2	#4,FFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL3
	BRW	ERLSO
ZZL3:

	MOVL	FFPT,INFFPT
	MOVL	PVNUM,R0
	MULL2	#4,R0

	MOVL	R0,TEMP
	MOVL	PVARPT,R0
	SUBL2	TEMP,R0

	MOVL	R0,STFFPT
BSNEXT:	BSBW	SMSKSW
	BSBW	SBSTPL
	CLRL	BESPT
BSLOOP:	BSBW	GTATOM
	CMPB	@IDPT,#STOPCD
	BNEQ	ZZL4
	BRW	MNSTOP
ZZL4:
	TSTL	NESTLV
	BEQL	BSNAME
; Search delimiter chain
	CLRL	HTABPT
	MOVL	DELPT,R0
	BSBW	LOSCHN

	BRW	MACERR
CHN1:	MOVL	CHANPT,R0
	BSBW	CMPARE

	BRW	BSC1
	BSBW	TEBEST
BSC1:	BSBW	LOECHN
	BRW	CHN1
	CMPL	MASKSW,#5
	BNEQ	ZZL5
	BRW	ENEXCL
ZZL5:
; Search chain of names
BSNAME:	CALLS	#0,MDFIND
BSN1:	MOVL	@HTABPT,CHANPT
BSHASH:	TSTL	CHANPT
	BEQL	BSSWIT
	MOVL	CHANPT,R0
	ADDL2	#4,R0

	BSBW	CMPARE
	BRW	BSH1
	BSBW	TEBEST
BSH1:	MOVL	@CHANPT,CHANPT
	BRB	BSHASH
BSSWIT:	BSBB	ZZL6
ZZL6:	MULL3	#3,BESTPL,R11
	ADDL2	R11,(SP)
	ADDL2	#15,(SP)
	RSB
	BRW	MNOUT
	BRW	CALLO
	BRW	WARNO
	BRW	CALLO
	BRW	SKIPPO
	BRW	DELLO
	BRW	BSLOOP
	BRW	WRNERR
	BRW	SASTAK
	BRW	STOPO
; Add atom to output text
MNOUT:	MOVL	IDPT,R0
	ADDL2	IDLEN,R0

	MOVL	R0,TEMPT
OUTLP:	CMPB	@IDPT,#SLREP
	BEQL	NOTOU
	MOVB	@IDPT,R2
	CALLS	#0,MDOUCH

NOTOU:	MOVL	IDPT,R0
	INCL	R0

	MOVL	R0,IDPT
	CMPL	R0,TEMPT
	BNEQU	OUTLP
	BRW	BSLOOP
; Place atom on forwards stack
SASTAK:	MOVL	FFPT,DSTPT
	MOVL	IDLEN,R0
	BSBW	BUMPFF

	MOVL	IDPT,SRCPT
	MOVL	SRCPT,R1
	MOVL	DSTPT,R2
	MOVC3	IDLEN,(R1),(R2)
	MOVL	ARGLEN,R0
	ADDL2	IDLEN,R0

	MOVL	R0,ARGLEN
	BRW	BSLOOP
; Action at end of source text
MNSTOP:	BSBW	ERMTST
	BRW	LOHALT
; Action at skip name
SKIPPO:	BSBW	ENCALL
	MOVL	@BINFPT,R0
	BICL2	#^C4,R0

	MOVL	R0,MASKSW
	TSTL	SKIPLV
	BNEQ	SKDEL
	MOVL	NESTLV,SKIPLV
	MOVL	@BINFPT,R0
	BICL2	#^C1,R0

	MOVL	R0,COPDSW
	MOVL	@BINFPT,R0
	BICL2	#^C2,R0

	MOVL	R0,COPTSW
; Skip delimiter
SKDEL:	BSBW	SBSTPL
	TSTL	COPTSW
	BNEQ	GL1
	MOVL	#6,BESTPL
GL1:	MOVL	BESPT,R0
	SUBL2	IDPT,R0

	INCL	R0
	MOVL	R0,IDLEN
	BSBW	RESSP
	BRW	SKD1
; End of skip
	BSBW	DECALV
	BRW	ENSKIP
	CMPL	SKIPLV,NESTLV
	BGTR	ENSKIP
; End of nested skip
	MOVL	#4,MASKSW
	BRB	BST1
; End of outermost skip
ENSKIP:	CLRL	SKIPLV
	TSTL	COPDSW
	BNEQ	ZZL7
	BRW	BSNEXT
ZZL7:
BSTREX:	BSBW	SMSKSW
	BSBW	SBSTPL
	CLRL	BESPT
BST1:	TSTL	IDLEN
	BNEQ	ZZL8
	BRW	BSLOOP
ZZL8:
	BRW	BSSWIT
; Non-closing skip delimiter
SKD1:	CMPL	SKIPLV,NESTLV
	BEQL	ZZL9
	BRW	BSSWIT
ZZL9:
	TSTL	COPDSW
	BNEQ	ZZL10
	BRW	BSLOOP
ZZL10:
	TSTL	SKVAL
	BEQL	ZZL11
	BRW	BSLOOP
ZZL11:
	TSTL	OPLEV
	BNEQ	ZZL12
	BRW	MNOUT
ZZL12:
	BRW	SASTAK
; Action at warning marker
WARNO:	BSBW	RESSP
	BRW	WRN1
WRN1:	MOVL	SPT,WNSPT
	MOVL	IDPT,WNIDPT
	CLRL	IDLEN
	BSBW	GSATOM
	BRW	WRNERR
	MOVL	#7,BESTPL
	MOVL	#1,MASKSW
	BRW	BSNAME
WRNERR:	MOVL	SVARPT,R1
	SUBL2	#12,R1
	TSTL	0(R1)
	BNEQ	GL2
	BSBW	ERSNW
GL2:	MOVL	WNIDPT,IDPT
	MOVL	WNSPT,R0
	MOVL	R0,SPT
	SUBL2	IDPT,R0
	INCL	R0
	MOVL	R0,IDLEN
	BRW	BSTREX
; Action at stop marker
STOPO:	MOVL	IDPT,R0
	DECL	R0

	MOVL	R0,SPT
	CMPB	@IDPT,#NLREP
	BNEQ	GL3
	MOVL	LINECT,R0
	DECL	R0

	MOVL	R0,LINECT
GL3:	BSBW	ERMTST
	BRW	BSNEXT
; Action at macro or insert name
CALLO:	BSBW	SMSKSW
	MOVL	BINFPT,TEMPT
	CMPL	@BINFPT,#4
	BNEQ	EL1
	CLRL	MASKSW
	ADDL2	#4,TEMPT
EL1:	TSTL	NESTLV
	BEQL	ZZL13
	BRW	MN2
ZZL13:
	MOVL	TEMPT,R0
	ADDL2	#4,R0

	MOVL	R0,CINFPT
	MOVL	@TEMPT,R0
	MOVL	R0,CALTYP
	CMPL	R0,#1
	BNEQ	MN1
	CMPL	OHSW,#1
	BEQL	MN1
	SUBL2	#4,LFPT
	MOVL	HASHPT,@LFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL14
	BRW	ERLSO
ZZL14:

	BSBW	STKHSH
MN1:	MOVL	#72,R0
	BSBW	DECLF

	MOVL	LFPT,NARGPT
	CLRL	ARGCT
	SUBL2	#4,LFPT
	MOVL	IDPT,@LFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL15
	BRW	ERLSO
ZZL15:

	MOVL	BESPT,R0
	INCL	R0

	SUBL2	#4,LFPT
	MOVL	R0,@LFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL16
	BRW	ERLSO
ZZL16:

	CLRL	R0
	SUBL2	SKVAL,R0

	DECL	R0
	MOVL	R0,SKVAL
MN2:	BSBW	ENCALL
	BRW	MXDEL1
; Action at secondary delimiter
DELLO:	TSTL	SKIPLV
	BEQL	EL2
	MOVL	BINFPT,R0
	ADDL2	BINDIC,R0

	MOVL	R0,DELPT
	BRW	SKDEL
EL2:	CMPL	NESTLV,#1
	BNEQ	MXDEL2
	INCL	ARGCT
	SUBL2	#4,LFPT
	MOVL	IDPT,@LFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL17
	BRW	ERLSO
ZZL17:

	MOVL	BESPT,R0
	INCL	R0

	SUBL2	#4,LFPT
	MOVL	R0,@LFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL18
	BRW	ERLSO
ZZL18:

MXDEL2:	MOVL	BINFPT,R0
	ADDL2	BINDIC,R0

	MOVL	R0,DELPT
MXDEL1:	MOVL	#6,BESTPL
	BSBW	RESSP
	BRW	BSLOOP
; Perform call
	BSBW	DECALV
	BRW	MN3
	BRW	BSNEXT
MN3:	CLRL	R0
	SUBL2	SKVAL,R0

	DECL	R0
	MOVL	R0,SKVAL
	SUBL2	#4,LFPT
	CLRL	@LFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL19
	BRW	ERLSO
ZZL19:

	MOVL	#ARGCT,SRCPT
	MOVL	NARGPT,DSTPT
	MOVL	SRCPT,R1
	MOVL	DSTPT,R2
	MOVC3	#72,(R1),(R2)
; Test for insert
	CMPL	CALTYP,#2
	BLSS	ZZL20
	BRW	OPINS
ZZL20:
	TSTL	SKVAL
	BEQL	EL3
; Still searching for label
	MOVL	NARGPT,R0
	ADDL2	#72,R0

	MOVL	R0,LFPT
	BRW	BSNEXT
EL3:	INCL	INVOCT
; Test for operation macro
	TSTL	CALTYP
	BLSS	ZZL21
	BRW	OPINS
ZZL21:
; Case of call of user macro
	INCL	LEVEL
	MOVL	CALTYP,R0
	ADDL2	CINFPT,R0

	SUBL2	#4,R0
	MOVL	R0,STOPPT
	MOVL	@CINFPT,R0
	ADDL2	CINFPT,R0

	DECL	R0
	MOVL	R0,SPT
	MOVL	MTCHPT,DBUGPT
	MOVL	#1,DBUGSW
	MOVL	NARGPT,R0
	MOVL	R0,STAKPT
	MOVL	R0,ARGPT
	BSBW	PRSCAN
; Set up temporary variables
	MOVL	LFPT,R0
	SUBL2	#4,R0

	MOVL	R0,TVARPT
	MOVL	CINFPT,R1
	MOVL	4(R1),R0
	MOVL	R0,TEMP
	SUBL2	#4,LFPT
	MOVL	R0,@LFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL22
	BRW	ERLSO
ZZL22:

	SUBL2	#4,LFPT
	MOVL	ARGCT,@LFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL23
	BRW	ERLSO
ZZL23:

	SUBL2	#4,LFPT
	MOVL	INVOCT,@LFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL24
	BRW	ERLSO
ZZL24:

	MOVL	LEVEL,R0
	SUBL2	OPLEV,R0

	SUBL2	#4,LFPT
	MOVL	R0,@LFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL25
	BRW	ERLSO
ZZL25:

	MOVL	TEMP,R0
	MULL2	#4,R0

	MOVL	R0,TEMP
	SUBL2	#12,R0
	BSBW	DECLF
	BRW	BSNEXT
; Perform operation macro call or insert
OPINS:	INCL	LEVEL
	TSTL	OPLEV
	BEQL	OPM1
	MOVL	#36,R0
	BSBW	DECLF

	MOVL	#TOPSPT,SRCPT
	MOVL	LFPT,DSTPT
	MOVL	SRCPT,R1
	MOVL	DSTPT,R2
	MOVC3	#36,(R1),(R2)
OPM1:	INCL	OPLEV
	MOVL	HASHPT,MHSHPT
	MOVL	LFPT,TOPSPT
	MOVL	CALTYP,OPTYP
	MOVL	#5,DBUGSW
	MOVL	#1,ARGNO
	MOVL	FFPT,INFFPT
	MOVL	NARGPT,R0
	MOVL	R0,STAKPT
	MOVL	R0,DBUGPT
; Test for insert
	CMPL	CALTYP,#2
	BLSS	ZZL26
	BRW	INSRT
ZZL26:
	MOVL	@CINFPT,TYPE
; Go to code associated with macro called
	BSBB	ZZL27
ZZL27:	MULL3	#3,TYPE,R11
	ADDL2	R11,(SP)
	ADDL2	#15,(SP)
	RSB
	BRW	MNO
	BRW	MWN
	BRW	MNO
	BRW	MNO
	BRW	DEF
	BRW	WRN
	BRW	INS
	BRW	SKIP
	BRW	MSET
	BRW	MGO
	BRW	ALT
	BRW	NTE
	BRW	PVR
	BRW	LNG
	BRW	SUB
	BRW	STP
; Perform insert
INSRT:	MOVL	SKVAL,SQNUM
	BSBW	STKARG
	BSBW	GARGCH
	BRW	ERLIA
	CMPB	@SPT,#^A\L\
	BNEQ	ZZL28
	BRW	INSL
ZZL28:
	TSTL	SQNUM
	BEQL	ZZL29
	BRW	MCEXIT
ZZL29:
	CLRL	WSW
	CMPB	@SPT,#^A\W\
	BNEQ	EL4
	MOVL	#1,WSW
	BSBW	GARGCH
	BRW	ERLIA
EL4:	MOVL	#5,INSW
	CMPB	@SPT,#^A\A\
	BNEQ	ZZL30
	BRW	INSA
ZZL30:
	CMPB	@SPT,#^A\B\
	BNEQ	ZZL31
	BRW	INSB
ZZL31:
	CMPB	@SPT,#^A\D\
	BEQL	INSD
	CMPL	WSW,#1
	BNEQ	ZZL32
	BRW	ERLIA
ZZL32:
; Case of macro expression
	MOVL	SPT,R0
	DECL	R0

	MOVL	R0,SPT
	BSBW	GETEXP
INV1:	CALLS	#0,MDCONV
FNCTEX:	MOVL	MDSPBASE,SP
	BSBW	OPEXIT
	BRW	BSTREX
; Arg etc
INSD:	MOVL	#6,INSW
	BSBW	GETEXP
	TSTL	MEVAL
	BNEQ	GL4
	TSTL	ARGPT
	BNEQ	INSA1
GL4:	BRB	INSA2
INSB:	MOVL	#4,INSW
INSA:	BSBW	GETEXP
INSA2:	MOVL	ARGPT,VARPT
	BSBW	ER1TST
INSA1:	MOVL	ARGPT,DBUGPT
	MOVL	MEVAL,ARGNO
	BSBW	PRARG
	CMPL	WSW,#1
	BNEQ	EL5
	MOVL	SPT,R0
	INCL	R0

	MOVL	R0,IDPT
	MOVL	STOPPT,R0
	SUBL2	IDPT,R0

	MOVL	R0,IDLEN
	BRW	FNCTEX
; Test for protected insert
EL5:	CMPL	OPTYP,#3
	BNEQ	GL5
	MOVL	DBUGPT,R1
	MOVL	40(R1),HASHPT
GL5:	BSBW	UNOPDB
	MOVL	STAKPT,LFPT
	MOVL	DBUGPT,R1
	MOVL	36(R1),TVARPT
	MOVL	DBUGPT,R1
	MOVL	8(R1),ARGPT
	BRW	BSNEXT
; Case of label
INSL:	BSBW	GETEXP
	TSTL	MEVAL
	BGTR	INSL1
	BRW	ERLME
INSL1:	BSBW	OPEXIT
	CMPL	MEVAL,SKVAL
	BNEQ	GL6
	CLRL	SKVAL
; Remember label if necessary
GL6:	TSTL	LEVEL
	BNEQ	ZZL33
	BRW	BSNEXT
ZZL33:
	BSBW	SKLAB
	BRW	INLMLT
	SUBL2	#4,LFPT
	MOVL	LINECT,@LFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL34
	BRW	ERLSO
ZZL34:

	MOVL	SPT,R0
	SUBL2	STOPPT,R0

	SUBL2	#4,LFPT
	MOVL	R0,@LFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL35
	BRW	ERLSO
ZZL35:

	SUBL2	#4,LFPT
	MOVL	MEVAL,@LFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL36
	BRW	ERLSO
ZZL36:

	SUBL2	#4,LFPT
	MOVL	LABPT,@LFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL37
	BRW	ERLSO
ZZL37:

	MOVL	LFPT,LABPT
	BRW	BSNEXT
INLMLT:	MOVL	@CHANPT,R0
	ADDL2	STOPPT,R0

	CMPL	R0,SPT
	BNEQU	ZZL38
	BRW	BSNEXT
ZZL38:
	BRW	ERLMD
; Action at end of piece of text
ENTEXT:	MOVL	MDSPBASE,SP
	TSTL	NESTLV
	BNEQ	ZZL39
	BRW	ENTX1
ZZL39:
	CMPL	DBUGSW,#4
	BEQL	GL7
	CMPL	DBUGSW,#2
	BEQL	ZZL40
	BRW	ENTX1
ZZL40:
; End of arg. Look ahead for exclusive delimiter
GL7:	MOVL	#6,INSW
	BSBW	SETPTS
	MOVL	IDPT,R0
	ADDL2	IDLEN,R0

	MOVL	R0,STOPPT
	MOVL	IDPT,R0
	DECL	R0

	MOVL	R0,SPT
	MOVL	#5,MASKSW
	BRW	BSLOOP
; Subsequently returning at
ENEXCL:	MOVL	IDPT,STOPPT
	CMPL	BINDIC,EXCLMK
	BNEQ	ZZL41
	BRW	DELLO
ZZL41:
ENTX1:	BSBW	ERMTST
ENTX2:	CMPL	DBUGSW,#2
	BNEQ	ZZL42
	BRW	SAEXIT
ZZL42:
	BSBW	UNSDB
	BRW	BSNEXT
; Exit from operation macro
MCEXIT:	BSBW	OPEXIT
	BRW	BSNEXT
; Error exit from operation macro
MCABRT:	BSBW	OPEXIT
	MOVL	#1,CAPSW
	MOVL	MTCHPT,R0
	BSBW	PRNAME

	PUSHAL	MES1
	CALLS	#1,MDMESS	; ' aborted due to above error$$'
	BRW	BSNEXT
;
; Subroutine ADVNCE
;
ADVNCE:
	INCL	SPT
	CMPL	SPT,STOPPT
	BNEQU	GL8
	RSB
GL8:	CMPL	SPT,FFPT
	BEQLU	ZZL43
	BRW	GOTIT
ZZL43:
	TSTL	NLSW
	BNEQ	ZZL44
	BRW	NOTSL
ZZL44:
; Update S2
	MOVL	SVARPT,R0
	SUBL2	#8,R0

	MOVL	R0,TEMPT
	MOVL	@TEMPT,R0
	INCL	R0

	MOVL	R0,@TEMPT
	CMPL	LINECT,TLINCT
	BNEQ	NOTTL
	MOVL	@TEMPT,TLINCT
NOTTL:	MOVL	@TEMPT,LINECT
	MOVL	TEMPT,R1
	TSTL	4(R1)
	BEQL	NOTSL
; Insert startline
	MOVB	#SLREP,@FFPT
	INCL	FFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL45
	BRW	ERLSO
ZZL45:

NOTSL:	MOVL	FFPT,TEMPT
	CALLS	#0,MDREAD
	BRW	RDSTOP
	MOVB	R2,@FFPT
	INCL	FFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL46
	BRW	ERLSO
ZZL46:

	CLRL	NLSW
	CMPB	@TEMPT,#NLREP
	BNEQ	GOTIT
	INCL	NLSW
	BRB	GOTIT
; End of input
RDSTOP:	MOVL	SPT,FFPT
; Add preceding newline if necessary
	TSTL	NLSW
	BNEQ	STPSTK
	MOVB	#NLREP,@FFPT
	INCL	FFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL47
	BRW	ERLSO
ZZL47:

STPSTK:	MOVB	#STOPCD,@FFPT
	INCL	FFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL48
	BRW	ERLSO
ZZL48:

GOTIT:	ADDL2	#3*1,(SP)
	RSB
;
; Subroutine BUMPFF
;
BUMPFF:	MOVL	R0,PARNM

	MOVL	FFPT,R0
	ADDL2	PARNM,R0

	MOVL	R0,FFPT
	CMPL	R0,LFPT
	BLSSU	ZZL49
	BRW	ERLSO
ZZL49:
	RSB
;
; Subroutine CHATOM
;
CHATOM:
	TSTL	ARGLEN
	BNEQ	ZZL50
	BRW	ERLIA
ZZL50:
	BSBW	GTATOM
	CMPL	IDLEN,ARGLEN
	BNEQ	GL10
	RSB
GL10:	BRW	ERLIA
;
; Subroutine CHEKID
;
CHEKID:
	BSBW	GSATOM
	BRW	ERLIA
	BSBW	GSATOM
	BRW	CKRET
	BRW	ERLIA
CKRET:	RSB
;
; Subroutine CKVALY
;
CKVALY:	MOVL	R0,PARNM

	CMPL	R0,ENDPT
	BGTRU	CKVEX
	MOVL	TYPE,R0
	MULL2	#4,R0

	MOVL	R0,TEMP
	MOVL	HASHPT,R0
	ADDL2	TEMP,R0

	ADDL2	#252,R0
	MOVL	R0,TEMAPT
	MOVL	PARNM,R0
	CMPL	R0,@TEMAPT

	BLSSU	CKVEX
	RSB
CKVEX:	ADDL2	#3*1,(SP)
	RSB
;
; Subroutine CMPARE
;
CMPARE:	MOVL	R0,PARNM

	ADDL2	#4,R0
	MOVL	R0,TEMAPT
	MOVL	IDLEN,R0
	CMPL	R0,@TEMAPT

	BEQL	GL12
	RSB
GL12:	ADDL2	#4,TEMAPT
	MOVL	TEMAPT,R0
	ADDL2	IDLEN,R0

	MOVL	R0,INFOPT
	MOVL	IDPT,TEMPT
CMP1:	MOVB	@TEMPT,R2
	CMPB	R2,@TEMAPT

	BEQL	GL13
	RSB
GL13:	INCL	TEMPT
	INCL	TEMAPT
	CMPL	TEMAPT,INFOPT
	BNEQU	CMP1
	MOVL	TEMAPT,R0

	MOVL	R0,INFOPT
	ADDL2	#3*1,(SP)
	RSB
;
; Subroutine CORECT
;
CORECT:
	MOVL	NDEFPT,R0
	CMPL	R0,@TEMPT

	BGTRU	CREXIT
	CMPL	@TEMPT,INFFPT
	BGTRU	CREXIT
	MOVL	@TEMPT,R0
	ADDL2	IDLEN,R0

	MOVL	R0,@TEMPT
CREXIT:	RSB
;
; Subroutine DECALV
;
DECALV:
	MOVL	NESTLV,R0
	DECL	R0

	MOVL	R0,NESTLV
	TSTL	R0
	BNEQ	GL14
	RSB
GL14:	MOVL	@LFPT,DELPT
	ADDL2	#4,LFPT
	MOVL	@LFPT,MTCHPT
	ADDL2	#4,LFPT
	MOVL	@LFPT,MCHLIN
	ADDL2	#4,LFPT
	MOVL	LFPT,CLLFPT
	ADDL2	#3*1,(SP)
	RSB
;
; Subroutine DECLF
;
DECLF:	MOVL	R0,PARNM

	MOVL	LFPT,R0
	SUBL2	PARNM,R0

	MOVL	R0,LFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL51
	BRW	ERLSO
ZZL51:
	RSB
;
; Subroutine ENCALL
;
ENCALL:
	TSTL	NESTLV
	BEQL	ENTC1
	SUBL2	#4,LFPT
	MOVL	MCHLIN,@LFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL52
	BRW	ERLSO
ZZL52:

	SUBL2	#4,LFPT
	MOVL	MTCHPT,@LFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL53
	BRW	ERLSO
ZZL53:

	SUBL2	#4,LFPT
	MOVL	DELPT,@LFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL54
	BRW	ERLSO
ZZL54:

ENTC1:	MOVL	LFPT,CLLFPT
	MOVL	BINFPT,R0
	ADDL2	BINDIC,R0

	SUBL2	#8,R0
	MOVL	R0,DELPT
	MOVL	BFNDPT,MTCHPT
	MOVL	LINECT,MCHLIN
	INCL	NESTLV
	RSB
;
; Subroutine ER1TST
;
ER1TST:
	TSTL	VARPT
	BNEQ	ZZL55
	BRW	ERLME
ZZL55:
	MOVL	MEVAL,R0
	CMPL	R0,@VARPT

	BLEQ	ZZL56
	BRW	ERLME
ZZL56:
	TSTL	MEVAL
	BLEQ	GL15
	RSB
GL15:	BRW	ERLME
;
; Subroutine GARGCH
;
GARGCH:
GAR1:	BSBW	ADVNCE
	BRW	GAREX
	CMPB	@SPT,#SPREP
	BEQL	GAR1
	ADDL2	#3*1,(SP)
	RSB
GAREX:	RSB
;
; Subroutine GETEXP
;
GETEXP:
	CLRL	SUM
	MOVL	SPT,OLIDPT
	MOVL	#1,VARSW
	CLRL	MEVAL
GXP1:	CLRL	OPSW
GXP3:	CLRL	NEGVAL
GXP6:	BSBW	GSATOM
	BRW	GMEXIT
	CMPB	@IDPT,#^A\+\
	BNEQ	ZZL57
	BRW	GMP
ZZL57:
	CMPB	@IDPT,#^A\-\
	BNEQ	ZZL58
	BRW	GMM
ZZL58:
	CMPB	@IDPT,#^A\*\
	BNEQ	ZZL59
	BRW	GMT
ZZL59:
	CMPB	@IDPT,#^A\/\
	BNEQ	ZZL60
	BRW	GMD
ZZL60:
	TSTL	VARSW
	BNEQ	ZZL61
	BRW	ERLIA
ZZL61:
	BSBW	LONUM
	BRW	GXP2
	BRB	GXP5
GXP2:	BSBW	GMEADD
GXP5:	CMPL	NEGVAL,#1
	BNEQ	GL16
	CLRL	R0
	SUBL2	MEVAL,R0

	MOVL	R0,MEVAL
GL16:	CLRL	VARSW
	TSTL	OPSW
	BNEQ	ZZL62
	BRW	GXP3
ZZL62:
	CALLS	#0,MDOP
	BRW	ERLOVF
	BRW	GXP1
; Minus and plus
GMM:	CLRL	R0
	SUBL2	NEGVAL,R0

	INCL	R0
	MOVL	R0,NEGVAL
GMP:	MOVL	SUM,R0
	ADDL2	MEVAL,R0

	MOVL	R0,SUM
GXP4:	MOVL	#1,VARSW
	CLRL	MEVAL
	BRW	GXP6
; Divide and times
GMD:	MOVL	#2,OPSW
	BRB	GMT1
GMT:	MOVL	#1,OPSW
GMT1:	CMPL	VARSW,#1
	BNEQ	ZZL63
	BRW	ERLIA
ZZL63:
	MOVL	MEVAL,OP1
	BRB	GXP4
GMEXIT:	CMPL	VARSW,#1
	BNEQ	ZZL64
	BRW	ERLIA
ZZL64:
	MOVL	MEVAL,R0
	ADDL2	SUM,R0

	MOVL	R0,MEVAL
	MOVL	OLIDPT,IDPT
	RSB
;
; Subroutine GMEADD
;
GMEADD:
	MOVL	IDPT,FLAGPT
GMD3:	CMPB	@IDPT,#^A\P\
	BNEQ	ZZL65
	BRW	GMD2
ZZL65:
	CMPB	@IDPT,#^A\S\
	BNEQ	ZZL66
	BRW	GMD2
ZZL66:
	CMPB	@IDPT,#^A\T\
	BNEQ	ZZL67
	BRW	GMD2
ZZL67:
	CMPL	IDPT,FLAGPT
	BNEQU	ZZL68
	BRW	ERLIA
ZZL68:
	BSBW	LONUM
	BRW	ERLIA
GMD1:	MOVL	IDPT,R0
	DECL	R0

	MOVL	R0,IDPT
	MOVL	PVARPT,VARPT
	CMPB	@IDPT,#^A\T\
	BNEQ	GL17
	MOVL	TVARPT,VARPT
GL17:	CMPB	@IDPT,#^A\S\
	BNEQ	GL18
	MOVL	SVARPT,VARPT
GL18:	BSBW	ER1TST
	MOVL	MEVAL,R0
	MULL2	#4,R0

	MOVL	R0,MEVAL
	MOVL	VARPT,R0
	SUBL2	MEVAL,R0

	MOVL	R0,TEMPT
	MOVL	@TEMPT,MEVAL
	CMPL	IDPT,FLAGPT
	BNEQU	GL19
	RSB
GL19:	BRW	GMD1
GMD2:	CMPL	IDPT,SPT
	BNEQU	ZZL69
	BRW	ERLIA
ZZL69:
	INCL	IDPT
	BRW	GMD3
;
; Subroutine GSATOM
;
GSATOM:
	BSBW	GARGCH
	BRW	GSERR
	CMPB	@SPT,#STOPCD
	BEQL	GSERR
	MOVL	SPT,R0
	DECL	R0

	MOVL	R0,SPT
	BSBB	GTATOM
	ADDL2	#3*1,(SP)
	RSB
GSERR:	MOVL	SPT,R0
	DECL	R0

	MOVL	R0,SPT
	RSB
;
; Subroutine GTATOM
;
GTATOM:
	TSTL	LEVEL
	BNEQ	EL6
	TSTL	SKVAL
	BLSS	EL6
	MOVL	FFPT,R0
	SUBL2	SPT,R0

	CMPL	R0,#1
	BNEQ	EL6
	MOVL	INFFPT,R0
	MOVL	R0,FFPT
	DECL	R0
	MOVL	R0,SPT
EL6:	BSBW	ADVNCE
	BRW	ENTEXT
	CMPB	@SPT,#NLREP
	BNEQ	GL20
	INCL	LINECT
GL20:	MOVL	SPT,IDPT
	MOVL	#1,IDLEN
	MOVB	@SPT,R2
	TSTB	MDPCTAB(R2)
	BNEQ	GT3

GT2:	BSBW	ADVNCE
	BRW	ENDID
	MOVB	@SPT,R2
	TSTB	MDPCTAB(R2)
	BNEQ	ENDID

	INCL	IDLEN
	BRB	GT2
; End of identifier
ENDID:	MOVL	SPT,R0
	DECL	R0

	MOVL	R0,SPT
GT3:	RSB
;
; Subroutine LUDEL
;
LUDEL:	MOVL	R0,PARNM

	BSBW	LOSCHN
	BRW	MACERR
CHN2:	MOVL	CHANPT,R0
	ADDL2	#4,R0

	BSBW	CMPARE
	BRW	LDCNT
	ADDL2	#3*1,(SP)
	RSB
LDCNT:	BSBW	LOECHN
	BRW	CHN2
	RSB
;
; Subroutine LULAYK
;
LULAYK:
	MOVL	#LAYCHN,R0
	BSBW	LOSCHN

	BRW	MACERR
CHN3:	MOVL	CHANPT,R0
	ADDL2	#4,R0

	MOVL	R0,TEMPT
	MOVL	@TEMPT,R0
	ADDL2	TEMPT,R0

	MOVL	R0,TIDPT
; Unless called from PRID routine ...
; ...compare with list of layout characters
	CMPL	EXITSW,#2
	BEQL	LKCONT
	MOVL	TEMPT,R0
	BSBW	CMPARE

	BRW	LKCONT
	MOVL	TIDPT,IDPT
	MOVL	#1,IDLEN
LULRET:	ADDL2	#3*1,(SP)
	RSB
LKCONT:	MOVB	@TIDPT,R2
	CMPB	R2,@IDPT

	BNEQ	GL21
	RSB
GL21:	CMPL	#KSPACS,CHANPT
	BEQLU	LULRET
	BSBW	LOECHN
	BRW	CHN3
	BRW	MACERR
;
; Subroutine MKROOM
;
MKROOM:
	MOVL	PVNUM,R0
	MULL2	#4,R0

	MOVL	R0,TEMP
	MOVL	PVARPT,R0
	SUBL2	TEMP,R0

	MOVL	R0,NDEFPT
	MOVL	IDLEN,R0
	BSBW	BUMPFF

	MOVL	NDEFPT,R0
	MOVL	R0,SRCPT
	ADDL2	IDLEN,R0
	MOVL	R0,DSTPT
	MOVL	FFPT,R0
	SUBL2	NDEFPT,R0

	SUBL2	IDLEN,R0
	MOVL	SRCPT,R1
	MOVL	DSTPT,R2
	MOVC3	R0,(R1),(R2)
	MOVL	STAKPT,DBUGPT
MKLOOP:	MOVL	DBUGPT,R1
	MOVL	32(R1),R0
	MOVL	R0,TEMPSW
	CMPL	R0,#1
	BNEQ	ZZL70
	BRW	MRMAC
ZZL70:
	MOVL	DBUGPT,R0
	ADDL2	#16,R0

	MOVL	R0,TEMPT
	BSBW	CORECT
	MOVL	DBUGPT,R0
	ADDL2	#56,R0

	MOVL	R0,TEMPT
	BSBW	CORECT
	TSTL	TEMPSW
	BNEQ	ZZL71
	BRW	MREXIT
ZZL71:
	MOVL	DBUGPT,R0
	ADDL2	#48,R0

	MOVL	R0,TEMPT
	BSBW	CORECT
	CMPL	TEMPSW,#2
	BNEQ	MKR1
	MOVL	DBUGPT,R1
	MOVL	12(R1),TEMPT
	BRB	MKR2
MKR1:	MOVL	DBUGPT,R1
	MOVL	4(R1),DBUGPT
	BRW	MKLOOP
MRMAC:	MOVL	DBUGPT,R1
	MOVL	8(R1),TEMPT
MKR2:	MOVL	TEMPT,R0
	SUBL2	#4,R0

	MOVL	R0,TEMPT
	TSTL	@TEMPT
	BEQL	MKR1
	BSBW	CORECT
	BRB	MKR2
MREXIT:	MOVL	PVARPT,R0
	ADDL2	IDLEN,R0

	MOVL	R0,PVARPT
	MOVL	INFFPT,R0
	ADDL2	IDLEN,R0

	MOVL	R0,INFFPT
	RSB
;
; Subroutine OPEXIT
;
OPEXIT:
	BSBW	UNOPDB
	BSBW	UNSDB
	RSB
;
; Subroutine PRARG
;
PRARG:
	MOVL	MHSHPT,HASHPT
	BSBW	SETPTS
	MOVL	IDPT,R0
	DECL	R0

	MOVL	R0,SPT
	MOVL	IDPT,R0
	ADDL2	IDLEN,R0

	MOVL	R0,STOPPT
	MOVL	INSW,R0
	BICL2	#^C6,R0

	MOVL	R0,DBUGSW
	CMPL	R0,INSW
	BEQL	PRGEX
; Delete spaces
	BSBW	GSATOM
	BRW	PRGEX
	MOVL	IDPT,R0
	DECL	R0

	MOVL	R0,SPT
PRG1:	MOVL	STOPPT,R0
	DECL	R0

	MOVL	R0,STOPPT
	CMPB	@STOPPT,#SPREP
	BEQL	PRG1
	INCL	STOPPT
PRGEX:	BSBB	PRSCAN
	RSB
;
; Subroutine PRSCAN
;
PRSCAN:
	CLRL	OHSW
	CLRL	SKVAL
	MOVL	#1,LINECT
	CLRL	LABPT
	RSB
;
; Subroutine RESSP
;
RESSP:
	MOVL	BESPT,SPT
	CLRL	BESPT
	CMPL	BINDIC,EXCLMK
	BEQL	RESEX
	MOVL	BESLIN,LINECT
	TSTL	BINDIC
	BEQL	RESRET
	RSB
; Exclusive delimiter
RESEX:	CLRL	IDLEN
	CLRL	BINDIC
	MOVL	IDPT,R0
	DECL	R0

	MOVL	R0,SPT
	CMPB	@IDPT,#NLREP
	BNEQ	RESRET
	MOVL	LINECT,R0
	DECL	R0

	MOVL	R0,LINECT
RESRET:	ADDL2	#3*1,(SP)
	RSB
;
; Subroutine SBSTPL
;
SBSTPL:
	CLRL	BESTPL
	TSTL	OPLEV
	BEQL	GL23
	MOVL	#8,BESTPL
GL23:	TSTL	SKVAL
	BEQL	GL24
	MOVL	#6,BESTPL
GL24:	RSB
;
; Subroutine SETPTS
;
SETPTS:
	MOVL	ARGNO,R0
	MULL2	#8,R0

	MOVL	R0,TEMP
	CMPL	INSW,#6
	BNEQ	GL25
	ADDL2	#4,TEMP
GL25:	MOVL	DBUGPT,R1
	SUBL2	TEMP,R1
	MOVL	0(R1),IDPT
	MOVL	DBUGPT,R1
	SUBL2	TEMP,R1
	SUBL2	#4,R1
	MOVL	0(R1),R0
	SUBL2	IDPT,R0

	MOVL	R0,IDLEN
	RSB
;
; Subroutine SKLAB
;
SKLAB:
	MOVL	LABPT,CHANPT
SKLOOP:	TSTL	CHANPT
	BNEQ	GL26
	ADDL2	#3*1,(SP)
	RSB
GL26:	MOVL	CHANPT,R1
	CMPL	4(R1),MEVAL
	BNEQ	EL9
	ADDL2	#8,CHANPT
	RSB
EL9:	MOVL	@CHANPT,CHANPT
	BRB	SKLOOP
;
; Subroutine SMSKSW
;
SMSKSW:
	MOVL	HASHPT,R1
	MOVL	272(R1),R0
	MCOML	GLBWSW,R11
	BICL2	R11,R0

	MOVL	R0,MASKSW
	RSB
;
; Subroutine STKHSH
;
STKHSH:
	MOVL	#1,OHSW
	MOVL	#276,R0
	BSBW	DECLF

	MOVL	HASHPT,SRCPT
	MOVL	LFPT,R0
	MOVL	R0,HASHPT
	MOVL	R0,DSTPT
	MOVL	SRCPT,R1
	MOVL	DSTPT,R2
	MOVC3	#276,(R1),(R2)
	RSB
;
; Subroutine SUBCHK
;
SUBCHK:
	MOVL	MEVAL,R0

	MOVL	R0,MEVAL
	CMPL	R0,OPTYP
	BGTR	SUBNUL
	TSTL	MEVAL
	BGTR	GL27
	MOVL	MEVAL,R0
	ADDL2	OPTYP,R0

	MOVL	R0,MEVAL
GL27:	CMPL	MEVAL,SQNUM
	BLEQ	SUBNUL
	RSB
; MCSUB has null value
SUBNUL:	CLRL	IDLEN
; Go to label in code to perform insert
	BRW	FNCTEX
;
; Subroutine TESDEL
;
TESDEL:	MOVL	R0,PARNM

	MOVL	#6,INSW
	BSBW	SETPTS
	CLRL	MEVAL
	MOVL	PARNM,R0
	BSBW	LOSCHN

	BRW	MACERR
CHN4:	MOVL	CHANPT,R0
	BSBW	CMPARE

	BRW	TDCNT
	RSB
TDCNT:	INCL	MEVAL
	BSBW	LOECHN
	BRW	CHN4
	BRW	MACERR
;
; Subroutine TEBEST
;
TEBEST:
	MOVL	IDPT,TIDPT
	MOVL	SPT,TSPT
	MOVL	LINECT,TLINCT
	MOVL	IDLEN,R0

	MOVL	R0,IDLEN
	MOVL	INFOPT,R0
	SUBL2	IDLEN,R0

	SUBL2	#8,R0
	MOVL	R0,FNDPT
TBSWIT:	CMPL	@INFOPT,SPCSMK
	BNEQ	EL10
	ADDL2	#4,INFOPT
	BSBW	GARGCH
	BRW	TBSW1
TBSW1:	MOVL	SPT,R0
	DECL	R0

	MOVL	R0,SPT
EL10:	MOVL	INFOPT,R0
	BSBW	TEWITH

	BRW	TBWITH
	CMPL	INDIC,EXCLMK
	BNEQ	TB1
; Exclusive delimiter
	CMPL	BINDIC,EXCLMK
	BNEQ	TB3
	BRB	TB2
; Not exclusive delimiter
TB1:	CMPL	BINDIC,EXCLMK
	BNEQ	ZZL72
	BRW	TEBEX
ZZL72:
TB2:	CMPL	BESPT,SPT
	BLSSU	ZZL73
	BRW	TEBEX
ZZL73:
TB3:	TSTL	HTABPT
	BNEQ	EL11
; Secondary delimiter case
	MOVL	#5,BESTPL
	BRW	UPDATE
EL11:	ADDL2	#4,INFOPT
	TSTL	@INFOPT
	BNEQ	NOTSTP
; Case of stop marker
	TSTL	LEVEL
	BEQL	ZZL74
	BRW	TEBEX
ZZL74:
	TSTL	SKVAL
	BNEQ	GL29
	TSTL	SKIPLV
	BNEQ	ZZL75
	BRW	TEBEX
ZZL75:
GL29:	MOVL	#9,BESTPL
	BRW	UPDATE
NOTSTP:	MOVL	@INFOPT,R0
	MCOML	MASKSW,R11
	BICL2	R11,R0

	MOVL	R0,TEMPSW
	TSTL	R0
	BNEQ	ZZL76
	BRW	TEBEX
ZZL76:
	MOVL	@INFOPT,R0
	MOVL	R0,TYPE
	CMPL	R0,#3
	BNEQ	GL30
	CMPL	MASKSW,#1
	BEQL	TEBEX
GL30:	MOVL	CHANPT,R0
	BSBW	CKVALY

	BRW	TEBEX
	ADDL2	#4,INFOPT
	MOVL	TYPE,BESTPL
UPDATE:	MOVL	FNDPT,BFNDPT
	MOVL	INFOPT,BINFPT
	MOVL	INDIC,BINDIC
	MOVL	SPT,BESPT
	MOVL	LINECT,BESLIN
TEBEX:	MOVL	TIDPT,IDPT
	MOVL	TSPT,R0
	MOVL	R0,SPT
	SUBL2	IDPT,R0
	INCL	R0
	MOVL	R0,IDLEN
	MOVL	TLINCT,LINECT
	RSB
; Composite name
TBWITH:	BSBW	ADVNCE
	BRW	TEBEX
	MOVL	SPT,R0
	DECL	R0

	MOVL	R0,SPT
	BSBW	GTATOM
	CMPB	@IDPT,#SPREP
	BNEQ	GL31
	CMPL	INDIC,WTHSMK
	BEQL	TBWITH
GL31:	MOVL	INFOPT,R0
	BSBW	CMPARE

	BRW	TEBEX
	BRW	TBSWIT
;
; Subroutine TEWITH
;
TEWITH:	MOVL	R0,PARNM

	MOVL	@PARNM,R0
	MOVL	R0,INDIC
	CMPL	R0,WITHMK
	BEQL	GL32
	CMPL	INDIC,WTHSMK
	BNEQ	GL33
GL32:	RSB
GL33:	ADDL2	#3*1,(SP)
	RSB
;
; Subroutine UNOPDB
;
UNOPDB:
	MOVL	INFFPT,FFPT
	MOVL	LEVEL,R0
	DECL	R0

	MOVL	R0,LEVEL
	MOVL	OPLEV,R0
	DECL	R0

	MOVL	R0,OPLEV
	TSTL	R0
	BNEQ	GL34
	RSB
GL34:	MOVL	TOPSPT,R0
	MOVL	R0,TEMPT
	MOVL	R0,SRCPT
	MOVL	#TOPSPT,DSTPT
	MOVL	SRCPT,R1
	MOVL	DSTPT,R2
	MOVC3	#36,(R1),(R2)
	MOVL	TEMPT,R0
	ADDL2	#36,R0

	MOVL	R0,LFPT
	RSB
;
; Subroutine UNSDB
;
UNSDB:
	CMPL	DBUGSW,#1
	BNEQ	GL35
	MOVL	LEVEL,R0
	DECL	R0

	MOVL	R0,LEVEL
GL35:	MOVL	STAKPT,R0
	MOVL	R0,TEMPT
	MOVL	R0,SRCPT
	MOVL	#ARGCT,DSTPT
	MOVL	SRCPT,R1
	MOVL	DSTPT,R2
	MOVC3	#72,(R1),(R2)
	MOVL	TEMPT,R0
	ADDL2	#72,R0

	MOVL	R0,LFPT
; Delete text of call if in source text
	TSTL	LEVEL
	BEQL	ZZL77
	BRW	UNSDEX
ZZL77:
	INCL	SPT
	MOVL	FFPT,R0
	SUBL2	SPT,R0

	MOVL	R0,TEMP
	TSTL	R0
	BEQL	GL36
	MOVL	SPT,SRCPT
	MOVL	INFFPT,DSTPT
	MOVL	SRCPT,R1
	MOVL	DSTPT,R2
	MOVC3	TEMP,(R1),(R2)
GL36:	MOVL	INFFPT,R0
	DECL	R0

	MOVL	R0,SPT
	MOVL	INFFPT,R0
	ADDL2	TEMP,R0

	MOVL	R0,FFPT
UNSDEX:	RSB
; The Linkroutine
;
; Linkroutine STKARG
;
STKARG:	POPL	LINKPT
	MOVL	#3,INSW
	BSBW	PRARG
	CLRL	ARGLEN
	BRW	BSNEXT
; When arg has been stacked, control returns here
SAEXIT:	MOVL	TOPSPT,LFPT
	MOVL	FFPT,R0
	MOVL	R0,STOPPT
	SUBL2	ARGLEN,R0
	MOVL	R0,ERIAPT
	DECL	R0
	MOVL	R0,SPT
	MOVL	#5,DBUGSW
	JMP	@LINKPT
; Code for MCALTERMAC
ALT:	MOVL	#2,ARGNO
	BSBW	STKARG
	BSBW	CHATOM
	MOVL	IDLEN,SQNUM
	MOVL	IDPT,SQPT
	MOVL	#1,ARGNO
	BSBW	STKARG
	BSBW	CHATOM
	MOVL	#DELCHN,R0
	BSBW	LUDEL

	BRW	ERLIA
	MOVL	SQNUM,ARGLEN
	MOVL	SQPT,ERIAPT
	MOVL	#2,ARGNO
ALT1:	MOVL	CHLINK,R0
	SUBL2	ARGLEN,R0

	CMPL	R0,#15
	BGTR	ZZL78
	BRW	ERLIA
ZZL78:
	MOVL	CHANPT,R0
	ADDL2	#12,R0

	MOVL	R0,SPT
; Test for case of N
	CMPL	SPT,KNPT
	BNEQU	GL37
	MOVB	@ERIAPT,R2
	TSTB	MDPCTAB(R2)
	BEQL	ZZL79
	BRW	ERLIA
ZZL79:

GL37:	MOVL	CHANPT,R0
	ADDL2	#8,R0

	MOVL	R0,LOTEMP
	MOVL	ARGLEN,@LOTEMP
	MOVL	SPT,R0
	ADDL2	ARGLEN,R0

	MOVL	R0,TEMPT
; TEMP is needed below in case fields overlap
	MOVL	@INFOPT,R0
	MOVL	R0,TEMP
	MOVL	R0,@TEMPT
	TSTL	@TEMPT
	BEQL	GL38
	MOVL	@TEMPT,R0
	ADDL2	INFOPT,R0

	SUBL2	TEMPT,R0
	MOVL	R0,@TEMPT
GL38:	MOVL	ERIAPT,SRCPT
	MOVL	SPT,DSTPT
	MOVL	SRCPT,R1
	MOVL	DSTPT,R2
	MOVC3	ARGLEN,(R1),(R2)
	MOVL	CHANPT,R0
	ADDL2	CHLINK,R0

	MOVL	R0,CHANPT
	BSBW	LUDEL
	BRW	MCEXIT
	BRW	ALT1
; Code for MCGOMAC
MGO:	CMPL	ARGCT,#1
	BNEQ	ZZL80
	BRW	GODO
ZZL80:
	MOVL	#DIF,R0
	BSBW	TESDEL

	MOVL	MEVAL,OPTYP
	MOVL	#2,ARGNO
	MOVL	#DGE,R0
	BSBW	TESDEL

	CLRL	SQNUM
	CLRL	SQSW
	BSBB	ZZL81
ZZL81:	MULL3	#3,MEVAL,R11
	ADDL2	R11,(SP)
	ADDL2	#15,(SP)
	RSB
	BRW	GOGREQ
	BRW	GOGRT
	BRW	GOEN
	BRW	GOBC
	BRW	GOEQU
; Character comparison
GOEQU:	BSBW	STKARG
	MOVL	ARGLEN,SQNUM
	MOVL	#3,ARGNO
	BSBW	STKARG
	CMPL	ARGLEN,SQNUM
	BEQL	ZZL82
	BRW	GOFAIL
ZZL82:
	MOVL	INFFPT,TEMPT
GOEQ1:	BSBW	ADVNCE
	BRW	GOSUC
	MOVB	@SPT,R2
	CMPB	R2,@TEMPT

	BEQL	ZZL83
	BRW	GOFAIL
ZZL83:
	INCL	TEMPT
	BRB	GOEQ1
; Belongs to class
GOBC:	BSBW	STKARG
	MOVL	#3,ARGNO
	BSBW	STKARG
	BSBW	CHEKID
	CMPL	IDLEN,#1
	BEQL	ZZL84
	BRW	ERLIA
ZZL84:
	BRW	LOGOBC
; Numerical comparison
GOGREQ:	MOVL	#1,SQNUM
GOGRT:	MOVL	#1,SQSW
GOEN:	BSBW	STKARG
	BSBW	GETEXP
	MOVL	SQNUM,R0
	ADDL2	MEVAL,R0

	MOVL	R0,SQNUM
	MOVL	#3,ARGNO
	BSBW	STKARG
	BSBW	GETEXP
	TSTL	SQSW
	BNEQ	EL12
	CMPL	MEVAL,SQNUM
	BEQL	GOSUC
	BRB	GOFAIL
EL12:	CMPL	MEVAL,SQNUM
	BGEQ	GOFAIL
GOSUC:	INCL	OPTYP
GOFAIL:	CMPL	OPTYP,#1
	BEQL	ZZL85
	BRW	MCEXIT
ZZL85:
	MOVL	#1,ARGNO
; Perform GO TO
GODO:	BSBW	STKARG
	BSBW	GARGCH
	BRW	ERLIA
	CMPB	@SPT,#^A\L\
	BEQL	ZZL86
	BRW	ERLIA
ZZL86:
	BSBW	GETEXP
	TSTL	MEVAL
	BNEQ	EL13
	CMPL	LEVEL,#1
	BNEQ	ZZL87
	BRW	ERLME
ZZL87:
	BSBW	OPEXIT
	BRW	ENTX2
EL13:	TSTL	MEVAL
	BGTR	ZZL88
	BRW	ERLME
ZZL88:
	BSBW	OPEXIT
	BSBW	SKLAB
	BRW	LABFND
	MOVL	MEVAL,SKVAL
	MOVL	MCHLIN,SKLIN
	BRW	BSNEXT
; Backwards GO TO
LABFND:	MOVL	@CHANPT,R0
	ADDL2	STOPPT,R0

	MOVL	R0,SPT
	MOVL	CHANPT,R1
	MOVL	4(R1),LINECT
	BRW	BSNEXT
; Code for MCLENGMAC
LNG:	BSBW	STKARG
	MOVL	ARGLEN,R0

	MOVL	R0,MEVAL
; Go to label in code to perform insert
	BRW	INV1
; Code for MCNOTEMAC
NTE:	BSBW	STKARG
	PUSHAL	MES2
	CALLS	#1,MDMESS	; '$'
	MOVL	ERIAPT,IDPT
	MOVL	ARGLEN,IDLEN
	BSBW	LOERPR
	BSBW	OPEXIT
	MOVL	SVARPT,R1
	SUBL2	#16,R1
	TSTL	0(R1)
	BNEQ	ZZL89
	BRW	ER2A
ZZL89:
	PUSHAL	MES2
	CALLS	#1,MDMESS	; '$'
	BRW	BSNEXT
; Code for MCPVARMAC
PVR:	BSBW	STKARG
	BSBW	GETEXP
	MOVL	MEVAL,R0
	SUBL2	PVNUM,R0

	MOVL	R0,IDLEN
	TSTL	R0
	BGTR	ZZL90
	BRW	MCEXIT
ZZL90:
	MOVL	IDLEN,R0
	MULL2	#4,R0

	MOVL	R0,IDLEN
	BSBW	MKROOM
; Zeroise new permanent variables
	MOVL	NDEFPT,R0
	ADDL2	IDLEN,R0

	MOVL	R0,TEMPT
ZNPLP:	MOVL	TEMPT,R0
	SUBL2	#4,R0

	MOVL	R0,TEMPT
	CLRL	@TEMPT
	CMPL	TEMPT,NDEFPT
	BNEQU	ZNPLP
	MOVL	MEVAL,R0
	MOVL	R0,PVNUM
	MOVL	R0,@PVARPT
	BRW	MCEXIT
; Code for MCSETMAC
MSET:	BSBW	STKARG
	BSBW	CHEKID
	MOVL	IDPT,R0
	ADDL2	IDLEN,R0

	DECL	R0
	MOVL	R0,SPT
	BSBW	GMEADD
	MOVL	TEMPT,SQPT
	MOVL	#2,ARGNO
	BSBW	STKARG
	BSBW	GETEXP
	MOVL	MEVAL,@SQPT
	BRW	MCEXIT
; Code for MCSUBMAC
SUB:	BSBW	STKARG
	MOVL	ARGLEN,OPTYP
	MOVL	#2,ARGNO
	BSBW	STKARG
	BSBW	GETEXP
	CLRL	SQNUM
	BSBW	SUBCHK
	MOVL	MEVAL,R0
	DECL	R0

	MOVL	R0,SQNUM
	MOVL	#3,ARGNO
	BSBW	STKARG
	BSBW	GETEXP
	BSBW	SUBCHK
	MOVL	MEVAL,R0
	SUBL2	SQNUM,R0

	MOVL	R0,IDLEN
	MOVL	INFFPT,R0
	ADDL2	SQNUM,R0

	MOVL	R0,IDPT
; Go to label in code to perform insert
	BRW	FNCTEX
; Code for MCNO--- macros
MWN:	MOVL	HASHPT,R0
	ADDL2	#272,R0

	MOVL	R0,LOTEMP
	MOVL	#7,@LOTEMP
; Above statement applies only to MCNOWARNMAC
MNO:	MOVL	TYPE,R0
	MULL2	#4,R0

	MOVL	R0,TYPE
	MOVL	HASHPT,R0
	ADDL2	TYPE,R0

	ADDL2	#256,R0
	MOVL	R0,LOTEMP
	MOVL	DBUGPT,R0
	ADDL2	#72,R0

	MOVL	R0,@LOTEMP
	BRW	MCEXIT
; Code for MCWARNMAC
WRN:	MOVL	#2,NTYPSW
	BRW	EVTREE
; Code for MCSTOPMAC
STP:	CLRL	NTYPSW
	BRW	EVTREE
; Code for MCDEFMAC
DEF:	MOVL	ARGCT,R0
	DECL	R0

	MOVL	R0,ARGNO
	MOVL	#DAS,R0
	BSBW	TESDEL

	CLRL	SQSW
	TSTL	MEVAL
	BEQL	GL39
	MOVL	#1,SQSW
GL39:	MOVL	#3,SQNUM
	CMPL	ARGCT,#2
	BEQL	DEF1
	MOVL	#1,ARGNO
	BSBW	STKARG
	BSBW	GETEXP
	CMPL	MEVAL,#3
	BLSS	DEF1
	MOVL	MEVAL,SQNUM
DEF1:	MOVL	INFFPT,R0

	MOVL	R0,FFPT
	MOVL	@DBUGPT,ARGNO
	BSBW	STKARG
	MOVL	ARGNO,R0
	DECL	R0

	MOVL	R0,ARGNO
	MOVL	#1,NTYPSW
	BRW	EVTREE
; Code for MCINSMAC
INS:	MOVL	#3,SQNUM
	MOVL	#3,NTYPSW
	CMPL	ARGCT,#1
	BNEQ	ZZL91
	BRW	EVTREE
ZZL91:
	BSBW	STKARG
	BSBW	CHEKID
	CMPL	IDLEN,#1
	BEQL	ZZL92
	BRW	ERLIA
ZZL92:
	CMPB	@IDPT,#^A\P\
	BNEQ	ZZL93
	BRW	EVTR2
ZZL93:
	CMPB	@IDPT,#^A\U\
	BEQL	MINSU
	BRW	ERLIA
MINSU:	MOVL	#2,SQNUM
	BRW	EVTR2
; Code for MCSKIPMAC
SKIP:	CLRL	SQSW
	MOVL	#4,NTYPSW
	CMPL	ARGCT,#1
	BNEQ	ZZL94
	BRW	EVTREE
ZZL94:
	BSBW	STKARG
SK3:	BSBW	GARGCH
	BRW	EVTR2
	CMPB	@SPT,#^A\D\
	BEQL	SKD
	CMPB	@SPT,#^A\T\
	BEQL	SKT
	CMPB	@SPT,#^A\M\
	BEQL	SKM
	BRW	ERLIA
SKD:	MOVL	SQSW,R0
	BISL2	#1,R0

	MOVL	R0,SQSW
	BRB	SK3
SKT:	MOVL	SQSW,R0
	BISL2	#2,R0

	MOVL	R0,SQSW
	BRW	SK3
SKM:	MOVL	SQSW,R0
	BISL2	#4,R0

	MOVL	R0,SQSW
	BRW	SK3
EVTR2:	MOVL	#2,ARGNO
; Deal with structure representation
EVTREE:	BSBW	STKARG
	CLRL	NODEPT
	CLRL	R0
	MOVL	R0,DELCT
	MOVL	R0,OPTLEV
	MOVL	#4,R0
	BSBW	BUMPFF

	MOVL	FFPT,R0

	MOVL	R0,FFPT
	CLRL	EXITSW
	MOVL	LFPT,LNODPT
	MOVL	#1,R0
	MOVL	R0,CONSW
	MOVL	R0,NODESW
	MOVL	R0,KEYSW
	BSBW	GETDEL
EV1:	MOVL	NTYPSW,@FFPT
	ADDL2	#4,FFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL95
	BRW	ERLSO
ZZL95:

	BSBB	ZZL96
ZZL96:	MULL3	#3,NTYPSW,R11
	ADDL2	R11,(SP)
	ADDL2	#15,(SP)
	RSB
	BRW	EV2
	BRW	EVMAC
	BRW	EV2
	BRW	EVINS
	BRW	EVSKIP
EVMAC:	TSTL	SQSW
	BEQL	GL41
	MOVL	#4,@FFPT
	ADDL2	#4,FFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL97
	BRW	ERLSO
ZZL97:

; Stack offsets of start and end...
; ...of replacement text
GL41:	MOVL	STOPPT,R0

	MOVL	R0,TEMAPT
	MOVL	ERIAPT,R0

	SUBL2	TEMAPT,R0
	ADDL2	FFPT,R0
	MOVL	R0,TEMPT
; TEMPT now points at final position of slot
	MOVL	ERIAPT,R0
	SUBL2	TEMPT,R0

	MOVL	R0,@FFPT
	ADDL2	#4,FFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL98
	BRW	ERLSO
ZZL98:

	MOVL	INFFPT,R0

	SUBL2	TEMPT,R0
	SUBL2	#4,R0
	MOVL	R0,@FFPT
	ADDL2	#4,FFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL99
	BRW	ERLSO
ZZL99:

EVINS:	MOVL	SQNUM,@FFPT
	ADDL2	#4,FFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL100
	BRW	ERLSO
ZZL100:

	BRB	EV2
EVSKIP:	MOVL	SQSW,@FFPT
	ADDL2	#4,FFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL101
	BRW	ERLSO
ZZL101:

EV2:	BSBW	GETDEL
	BRB	EV2
; Action at OPT
EVOPT:	MOVL	MDSPBASE,SP
	INCL	OPTLEV
	MOVL	#12,R0
	BSBW	DECLF

	MOVL	#ALLPT,SRCPT
	MOVL	LFPT,DSTPT
	MOVL	SRCPT,R1
	MOVL	DSTPT,R2
	MOVC3	#12,(R1),(R2)
	MOVL	FFPT,R0
	MOVL	R0,OPTHPT
	MOVL	R0,OPTPT
	CLRL	ALLPT
	CLRL	NODESW
	BSBW	GETDEL
EVCONT:	TSTL	DELCT
	BNEQ	ZZL102
	BRW	EV1
ZZL102:
	BRW	EV2
; Action at OR
EVOR:	MOVL	MDSPBASE,SP
	BSBW	JOINCH
	TSTL	DELCT
	BNEQ	GL42
	MOVL	#4,R0
	BSBW	BUMPFF

GL42:	MOVL	OPTPT,NODEPT
	MOVL	FFPT,OPTPT
	MOVL	#1,NODESW
	BSBW	GETDEL
; Check that name of branch is unique
	MOVL	OPTHPT,R0
	BSBW	LOSCHN

	BRW	MACERR
CHN5:	CMPL	CHANPT,OPTPT
	BNEQU	ZZL103
	BRW	EVCONT
ZZL103:
	MOVL	OPTPT,IDPT
	MOVL	CHANPT,INFOPT
EVOR4:	MOVL	IDPT,R1
	MOVL	4(R1),IDLEN
	ADDL2	#8,IDPT
	MOVL	INFOPT,R0
	BSBW	CMPARE

	BRW	EVDIFF
	MOVL	IDPT,R0
	ADDL2	IDLEN,R0

	MOVL	R0,IDPT
; Check WITH, WITHS and SPACES
	BSBW	TESPAC
	MOVL	INFOPT,TEMPT
	MOVL	IDPT,INFOPT
	MOVL	TEMPT,IDPT
	BSBW	TESPAC
	MOVL	INFOPT,R0
	BSBW	TEWITH

	BRW	EVOR1
	MOVL	IDPT,R0
	BSBW	TEWITH

	BRW	EVDIFF
	BRW	ERLIA
EVOR1:	MOVL	IDPT,R0
	BSBW	TEWITH

	BRW	EVOR4
EVDIFF:	BSBW	LOECHN
	BRW	CHN5
; Action at end of string
EVEXIT:	MOVL	MDSPBASE,SP
	TSTL	DELCT
	BNEQ	ZZL104
	BRW	ERLIA
ZZL104:
	TSTL	OPTLEV
	BEQL	ZZL105
	BRW	ERLIA
ZZL105:
	MOVL	NODEPT,R0
	BSBW	LOSCHN

	BRW	EVEX1
CHN6:	CLRL	@CHANPT
	BSBW	LOECHN
	BRW	CHN6
; Check that all nodes have been placed
EVEX2:	CMPL	LFPT,TOPSPT
	BEQLU	PLDEF
	MOVL	LFPT,R1
	TSTL	4(R1)
	BNEQ	ZZL106
	BRW	ERLIA
ZZL106:
	ADDL2	#12,LFPT
	BRB	EVEX2
EVEX1:	TSTL	EXITSW
	BNEQ	ZZL107
	BRW	ERLIA
ZZL107:
	BRB	EVEX2
; Action after processing...
; ...of structure representation
PLDEF:	MOVL	#4,OFFSET
	MOVL	STOPPT,R0

	MOVL	R0,STOPPT
	MOVL	FFPT,R0
	SUBL2	STOPPT,R0

	MOVL	R0,IDLEN
	BSBB	ZZL108
ZZL108:	MULL3	#3,NTYPSW,R11
	ADDL2	R11,(SP)
	ADDL2	#15,(SP)
	RSB
	BRW	PLSTOP
	BRW	PLMAC
	BRW	PLWARN
	BRW	PLINS
	BRW	ADDENV
; Macro case -- make delimiter structure ...
; ...adjacent to replacement text
PLMAC:	MOVL	STOPPT,SRCPT
	MOVL	ERIAPT,R0

	MOVL	R0,DSTPT
	MOVL	R0,ERIAPT
	MOVL	SRCPT,R1
	MOVL	DSTPT,R2
	MOVC3	IDLEN,(R1),(R2)
	MOVL	INFFPT,R0

	MOVL	R0,STOPPT
	MOVL	ERIAPT,R0
	ADDL2	IDLEN,R0

	MOVL	R0,FFPT
	MOVL	OFFSET,R0
	ADDL2	ERIAPT,R0

	SUBL2	STOPPT,R0
	MOVL	R0,OFFSET
	MOVL	FFPT,R0
	SUBL2	STOPPT,R0

	MOVL	R0,IDLEN
	BRW	ADDENV
; Warning case
PLWARN:	CMPL	DELCT,#1
	BEQL	ZZL109
	BRW	ERLIA
ZZL109:
	TSTL	OPTYP
	BEQL	PLWG
	MOVL	HASHPT,R0
	ADDL2	#272,R0

	MOVL	R0,LOTEMP
	MOVL	#6,@LOTEMP
	BRB	ADDENV
PLWG:	MOVL	#6,GLBWSW
	BRB	ADDENV
; Stop marker case
PLSTOP:	CMPL	DELCT,#1
	BEQL	ZZL110
	BRW	ERLIA
ZZL110:
	BRB	ADDENV
; Insert case
PLINS:	CMPL	DELCT,#2
	BEQL	ZZL111
	BRW	ERLIA
ZZL111:
; Add to environment
ADDENV:	MOVL	STOPPT,IDPT
	CMPL	OPTYP,#1
	BEQL	LOCDEF
	BSBW	MKROOM
	MOVL	IDPT,R0
	ADDL2	IDLEN,R0

	MOVL	R0,IDPT
	BSBW	OPEXIT
	BRB	PLD1
; Local case
LOCDEF:	BSBW	OPEXIT
	MOVL	IDLEN,R0
	BSBW	DECLF

	MOVL	LFPT,NDEFPT
PLD1:	MOVL	SPT,BESPT
	MOVL	IDPT,SRCPT
	MOVL	NDEFPT,DSTPT
	MOVL	SRCPT,R1
	MOVL	DSTPT,R2
	MOVC3	IDLEN,(R1),(R2)
	MOVL	NDEFPT,R0
	ADDL2	OFFSET,R0

	BSBW	LOSCHN
	BRW	MACERR
CHN7:	MOVL	CHANPT,R0
	ADDL2	#4,R0

	MOVL	R0,IDPT
	MOVL	@IDPT,IDLEN
	ADDL2	#4,IDPT
	MOVL	IDPT,R0
	ADDL2	IDLEN,R0

	DECL	R0
	MOVL	R0,SPT
	CALLS	#0,MDFIND
	MOVL	HTABPT,R0
	SUBL2	HASHPT,R0

	MOVL	R0,OFFSET
	CMPL	NDEFPT,LFPT
	BEQLU	GL43
; Find end of locals
FENLOC:	CMPL	@HTABPT,LFPT
	BLSSU	GL43
	CMPL	@HTABPT,ENDPT
	BGEQU	GL43
	MOVL	@HTABPT,HTABPT
	BRB	FENLOC
GL43:	MOVL	CHANPT,R0
	SUBL2	#4,R0

	MOVL	R0,TEMPT
	MOVL	@HTABPT,@TEMPT
	MOVL	TEMPT,@HTABPT
	CMPL	NDEFPT,LFPT
	BEQLU	PLDCH
	MOVL	HASHPT,TEMAPT
; Add globals to all hash tables
BCHSH:	MOVL	TEMAPT,R1
	MOVL	276(R1),R0
	MOVL	R0,TEMAPT
	TSTL	R0
	BEQL	PLDCH
	MOVL	TEMAPT,R0
	ADDL2	OFFSET,R0

	MOVL	R0,SRCPT
	MOVL	@SRCPT,R0
	CMPL	R0,@TEMPT

	BNEQU	NGAD
	MOVL	TEMPT,@SRCPT
NGAD:	BRB	BCHSH
PLDCH:	BSBW	LOECHN
	BRW	CHN7
	MOVL	BESPT,SPT
	BRW	BSNEXT
;
; Subroutine ERTEST
;
ERTEST:	MOVL	R0,PARNM

	TSTL	R0
	BNEQ	ZZL112
	BRW	ERLIA
ZZL112:
	CMPL	NTYPSW,#1
	BEQL	GL44
	CMPL	NTYPSW,#4
	BNEQ	GL45
GL44:	RSB
GL45:	BRW	ERLIA
;
; Subroutine GETDEL
;
GETDEL:
GDNEXT:	MOVL	#3,TYPE
	BSBW	GSRATM
	BRW	EVEXIT
GD1:	MOVL	SPT,OLDSPT
	BSBW	KEYSRC
	BRW	GDKEY
	MOVB	@IDPT,R2
	CMPB	R2,@KNPT

	BNEQ	GD2
	CMPL	IDLEN,#1
	BEQL	ZZL113
	BRW	TRYNOD
ZZL113:
; Case of delimiter
GD2:	CMPL	TYPE,#3
	BEQL	ZZL114
	BRW	GDW1
ZZL114:
; Place LID on forwards stack...
; ...and link it up
	MOVL	FFPT,R0
	BSBW	SNODCH

	CLRL	@FFPT
	ADDL2	#4,FFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL115
	BRW	ERLSO
ZZL115:

GTLOOP:	MOVL	IDLEN,@FFPT
	ADDL2	#4,FFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL116
	BRW	ERLSO
ZZL116:

	MOVL	FFPT,DSTPT
	MOVL	IDLEN,R0
	BSBW	BUMPFF

	MOVL	FFPT,R0

	MOVL	R0,FFPT
	MOVL	IDPT,SRCPT
	MOVL	SRCPT,R1
	MOVL	DSTPT,R2
	MOVC3	IDLEN,(R1),(R2)
; Look ahead for WITH or WITHS
	MOVL	IDPT,EXIDPT
	BSBW	GSRATM
	BRW	GTEXIT
	BSBW	KEYSRC
	BRW	GDWITH
GTEXIT:	CMPL	#SPCSRP,EXIDPT
	BNEQU	GL47
	MOVL	SPCSMK,@FFPT
	ADDL2	#4,FFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL117
	BRW	ERLSO
ZZL117:

GL47:	MOVL	OLDSPT,SPT
	MOVL	FFPT,NODEPT
	CLRL	@FFPT
	ADDL2	#4,FFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL118
	BRW	ERLSO
ZZL118:

GD4:	TSTL	OPTLEV
	BNEQ	GL48
	INCL	DELCT
GL48:	MOVL	#1,R0
	MOVL	R0,KEYSW
	MOVL	R0,NODESW
	RSB
; Test for WITHS or WITH
GDWITH:	CMPL	TYPE,#2
	BLSS	ZZL119
	BRW	GTEXIT
ZZL119:
	TSTL	TYPE
	BNEQ	EL14
	CMPL	#SPCSRP,EXIDPT
	BEQLU	EL14
	MOVL	WITHMK,@FFPT
	ADDL2	#4,FFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL120
	BRW	ERLSO
ZZL120:

	BRB	GDW2
EL14:	MOVL	WTHSMK,@FFPT
	ADDL2	#4,FFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL121
	BRW	ERLSO
ZZL121:

GDW2:	CLRL	R0
	MOVL	R0,NODESW
	MOVL	R0,KEYSW
	BSBW	GSRATM
	BRW	ERLIA
	BRW	GD1
; Subsequently returning here to perform checking
GDW1:	CMPL	TYPE,#1
	BNEQ	EL15
	CMPB	@IDPT,#SPREP
	BEQL	ZZL122
	BRW	GTLOOP
ZZL122:
; Convert   WITHS SPACE   to   WITH SPACES
	MOVL	FFPT,R0
	SUBL2	#4,R0

	MOVL	R0,LOTEMP
	MOVL	WITHMK,@LOTEMP
	MOVL	#SPCSRP,IDPT
	BRW	GTLOOP
EL15:	MOVB	@IDPT,R2
	TSTB	MDPCTAB(R2)
	BEQL	ZZL123
	BRW	GTLOOP
ZZL123:

	MOVB	@EXIDPT,R2
	TSTB	MDPCTAB(R2)
	BEQL	ZZL124
	BRW	GTLOOP
ZZL124:

	BRW	ERLIA
; Case of keyword
GDKEY:	MOVL	KEYSW,R0
	BSBW	ERTEST

	CLRL	KEYSW
	BSBB	ZZL125
ZZL125:	MULL3	#3,TYPE,R11
	ADDL2	R11,(SP)
	ADDL2	#15,(SP)
	RSB
	BRW	ERLIA
	BRW	ERLIA
	BRW	EVOPT
	BRW	EVOR
	BRW	GDALL
; Action at ALL
GDALL:	BSBW	JOINCH
	MOVL	ALLPT,NODEPT
	CLRL	CONSW
	MOVL	LFPT,SRCPT
	MOVL	#ALLPT,DSTPT
	MOVL	SRCPT,R1
	MOVL	DSTPT,R2
	MOVC3	#12,(R1),(R2)
	MOVL	LFPT,R0
	ADDL2	#12,R0

	MOVL	R0,LFPT
	MOVL	OPTLEV,R0
	DECL	R0

	MOVL	R0,OPTLEV
	BRW	GD4
; Node is false alarm
GD3:	MOVL	IDPT,R0
	DECL	R0

	MOVL	R0,IDPT
	BRW	GD2
; Test for node
TRYNOD:	INCL	IDPT
	BSBW	LONUM
	BRW	GD3
	MOVL	NODESW,R0
	BSBW	ERTEST

	CLRL	NODESW
; Test whether placing or go to
	BSBW	GSRATM
	BRW	NDGO
	BSBW	KEYSRC
	BRW	NDKEY
; Case of placing
NDPLAC:	TSTL	MEVAL
	BNEQ	ZZL126
	BRW	ERLIA
ZZL126:
	MOVL	#1,CONSW
	BSBW	PLNODE
	BRW	GNOD1
	CMPL	@NNODPT,#1
	BNEQ	ZZL127
	BRW	ERLIA
ZZL127:
	MOVL	FFPT,R0
	BSBW	SNODCH

	MOVL	TEMPT,NODEPT
GNOD1:	MOVL	#1,@NNODPT
	MOVL	NNODPT,R0
	ADDL2	#4,R0

	MOVL	R0,LOTEMP
	MOVL	FFPT,@LOTEMP
	BRW	GNOD4
NDKEY:	BSBB	ZZL128
ZZL128:	MULL3	#3,TYPE,R11
	ADDL2	R11,(SP)
	ADDL2	#15,(SP)
	RSB
	BRW	ERLIA
	BRW	ERLIA
	BRW	NDPLAC
	BRW	NDGO
	BRW	NDGO
; Node is gone to
NDGO:	TSTL	MEVAL
	BNEQ	ZZL129
	BRW	NDN0
ZZL129:
	TSTL	NODEPT
	BNEQ	ZZL130
	BRW	ERLIA
ZZL130:
	BSBW	PLNODE
	BRW	NUNODE
	CMPL	@NNODPT,#1
	BNEQ	ZZL131
	BRW	OLDNOD
ZZL131:
	MOVL	TEMPT,R0
	BSBW	LOSCHN

	BRW	NUND1
CHN8:	BSBW	LOECHN
	BRW	CHN8
	MOVL	NODEPT,R0
	SUBL2	CHANPT,R0

	MOVL	R0,@CHANPT
	BRB	GNOD3
NUNODE:	CLRL	@NNODPT
NUND1:	MOVL	NNODPT,R0
	ADDL2	#4,R0

	MOVL	R0,LOTEMP
	MOVL	NODEPT,@LOTEMP
GNOD3:	CLRL	NODEPT
GNOD4:	MOVL	OLDSPT,SPT
	BRW	GDNEXT
; Going to old node
OLDNOD:	MOVL	TEMPT,R0
	BSBW	SNODCH

	BRB	GNOD3
; Node N0
NDN0:	MOVL	NODEPT,R0
	BSBW	LOSCHN

	BRW	ERLIA
CHN9:	MOVL	EXCLMK,@CHANPT
	BSBW	LOECHN
	BRW	CHN9
	MOVL	#1,EXITSW
	BRW	GNOD3
;
; Subroutine GSRATM
;
GSRATM:
GSR1:	MOVL	STOPPT,R0
	SUBL2	SPT,R0

	CMPL	R0,#1
	BNEQ	GL49
	RSB
GL49:	BSBW	GTATOM
	BSBW	LULAYK
	BRW	GSR1
	ADDL2	#3*1,(SP)
	RSB
;
; Subroutine JOINCH
;
JOINCH:
	TSTL	OPTLEV
	BNEQ	ZZL132
	BRW	ERLIA
ZZL132:
; Add NODEPT chain to head of ALLPT chain
	MOVL	NODEPT,R0
	BSBW	LOSCHN

	BRW	JC1
CHN10:	BSBW	LOECHN
	BRW	CHN10
	TSTL	ALLPT
	BEQL	GL50
	MOVL	ALLPT,R0
	SUBL2	CHANPT,R0

	MOVL	R0,@CHANPT
GL50:	MOVL	NODEPT,ALLPT
JC1:	RSB
;
; Subroutine KEYSRC
;
KEYSRC:
	MOVL	#KEYCHN,R0
	BSBW	LUDEL

	BRW	KEYRET
	MOVL	CHANPT,R1
	MOVL	4(R1),TYPE
	RSB
KEYRET:	ADDL2	#3*1,(SP)
	RSB
;
; Subroutine PLNODE
;
PLNODE:
	MOVL	LNODPT,NNODPT
PLN2:	CMPL	NNODPT,TOPSPT
	BEQLU	PLN1
	CMPL	@NNODPT,MEVAL
	BNEQ	EL16
	ADDL2	#4,NNODPT
	MOVL	NNODPT,R1
	MOVL	4(R1),TEMPT
	ADDL2	#3*1,(SP)
	RSB
EL16:	ADDL2	#12,NNODPT
	BRB	PLN2
; Reserve new node
PLN1:	MOVL	LFPT,OLLFPT
	MOVL	#12,R0
	BSBW	DECLF

	CMPL	LNODPT,OLLFPT
	BEQLU	EL17
	MOVL	OLLFPT,SRCPT
	MOVL	LFPT,DSTPT
	MOVL	LNODPT,R0
	SUBL2	OLLFPT,R0

	MOVL	SRCPT,R1
	MOVL	DSTPT,R2
	MOVC3	R0,(R1),(R2)
EL17:	MOVL	LNODPT,R0
	SUBL2	#12,R0

	MOVL	R0,LNODPT
	MOVL	MEVAL,@LNODPT
	MOVL	LNODPT,R0
	ADDL2	#4,R0

	MOVL	R0,NNODPT
	RSB
;
; Subroutine SNODCH
;
SNODCH:	MOVL	R0,PARNM

	MOVL	R0,TEMAPT
	MOVL	NODEPT,R0
	BSBW	LOSCHN

	BRW	SND1
CHN11:	MOVL	TEMAPT,R0
	SUBL2	CHANPT,R0

	MOVL	R0,@CHANPT
	BSBW	LOECHN
	BRW	CHN11
	RSB
SND1:	TSTL	CONSW
	BNEQ	ZZL133
	BRW	ERLIA
ZZL133:
	RSB
;
; Subroutine TESPAC
;
TESPAC:
	CMPL	@INFOPT,SPCSMK
	BEQL	TSP2
	CMPL	@INFOPT,WTHSMK
	BNEQ	TSP1
TSP2:	CMPL	@IDPT,WITHMK
	BNEQ	TSP1
	MOVL	IDPT,R1
	CMPB	8(R1),#SPREP
	BNEQ	TSP1
	MOVL	IDPT,R0
	ADDL2	#9,R0

	MOVL	R0,IDPT
	BRB	TSP2
TSP1:	RSB
; Illegal macro element
ERLME:	MOVL	MDSPBASE,SP
	BSBW	PRERR
	MOVL	#1,IDLEN
	BSBW	LOERPR
	MOVL	MEVAL,R0
	BSBW	PRNUM

	PUSHAL	MES3
	CALLS	#1,MDMESS	; ' is illegal macro element'
ER1A:	BSBW	PRCTXT
	BRW	MCABRT
; Multiply-defined label
ERLMD:	BSBW	PRERR
	PUSHAL	MES4
	CALLS	#1,MDMESS	; 'Label '
	MOVL	MEVAL,R0
	BSBW	PRNUM

	PUSHAL	MES5
	CALLS	#1,MDMESS	; ' is multiply-defined'
ER2A:	BSBW	PRCTXT
	BRW	BSNEXT
; Illegal input character
;
; Subroutine ERSIC
;
ERSIC:
	SUBL2	#4,LFPT
	MOVL	IDPT,@LFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL134
	BRW	ERLSO
ZZL134:

	SUBL2	#4,LFPT
	MOVL	IDLEN,@LFPT
	CMPL	FFPT,LFPT
	BLSSU	ZZL135
	BRW	ERLSO
ZZL135:

	BSBW	PRERR
	PUSHAL	MES6
	CALLS	#1,MDMESS	; 'Illegal input character'
	BSBW	PRCTXT
	MOVL	@LFPT,IDLEN
	ADDL2	#4,LFPT
	MOVL	@LFPT,IDPT
	ADDL2	#4,LFPT
	RSB
; Illegal name after warning
;
; Subroutine ERSNW
;
ERSNW:
	BSBW	PRERR
	PUSHAL	MES7
	CALLS	#1,MDMESS	; 'Illegal macro name after warning'
	BSBW	PRVIZ
	RSB
; Test for mismatches
;
; Subroutine ERMTST
;
ERMTST:
	TSTL	SKIPLV
	BNEQ	GL52
	TSTL	SKVAL
	BNEQ	GL52
	RSB
GL52:	BSBW	PRERR
	BSBW	PRMISS
	RSB
; Stack overflow
ERLSO:	MOVL	MDSPBASE,SP
	BSBW	PRERR
	PUSHAL	MES8
	CALLS	#1,MDMESS	; 'Process aborted for lack of storage'
	TSTL	DBUGSW
	BNEQ	ER7A
	TSTL	SKIPLV
	BNEQ	GL53
	TSTL	SKVAL
	BEQL	ER7A
GL53:	PUSHAL	MES9
	CALLS	#1,MDMESS	; ' possibly due to$'
	BSBW	PRMISS
	BRW	LOHALT
ER7A:	BSBW	PRCTXT
	BRW	LOHALT
; Arithmetic overflow
ERLOVF:	MOVL	MDSPBASE,SP
	BSBW	PRERR
	PUSHAL	MES10
	CALLS	#1,MDMESS	; 'Arithmetic overflow'
	BRW	ER1A
; Illegal argument
ERLIA:	MOVL	MDSPBASE,SP
	BSBW	PRERR
	PUSHAL	MES11
	CALLS	#1,MDMESS	; 'Argument '
	MOVL	ARGNO,R0
	BSBW	PRNUM

	PUSHAL	MES12
	CALLS	#1,MDMESS	; ' has illegal value'
	MOVL	ARGLEN,IDLEN
	MOVL	ERIAPT,IDPT
	BSBW	PRVIZ
	BRW	MCABRT
; System error
MACERR:	MOVL	MDSPBASE,SP
	BSBW	PRERR
	PUSHAL	MES13
	CALLS	#1,MDMESS	; 'System error$$'
	BRW	LOHALT
; Subroutines for error print-outs
;
; Subroutine PRCTXT
;
PRCTXT:
	MOVL	#STAKPT,SRCPT
	MOVL	ETEMPT,DSTPT
	MOVL	SRCPT,R1
	MOVL	DSTPT,R2
	MOVC3	#32,(R1),(R2)
	PUSHAL	MES14
	CALLS	#1,MDMESS	; '$$detected in$'
	CMPL	DBUGSW,#5
	BNEQ	ZZL136
	BRW	EROP
ZZL136:
PRCT2:	MOVL	LINECT,R0
	BSBW	PRLINO

PRCT3:	PUSHAL	MES15
	CALLS	#1,MDMESS	; ' of '
	BSBB	ZZL137
ZZL137:	MULL3	#3,DBUGSW,R11
	ADDL2	R11,(SP)
	ADDL2	#15,(SP)
	RSB
	BRW	ERPSRC
	BRW	ERMAC
	BRW	ERARG
	BRW	MACERR
	BRW	ERARG
	BRW	MACERR
	BRW	ERDEL
; In macro
ERMAC:	CLRL	CAPSW
	MOVL	DBUGPT,R0
	BSBW	PRNAME

	PUSHAL	MES16
	CALLS	#1,MDMESS	; ' with '
	TSTL	@ARGPT
	BNEQ	GL54
	PUSHAL	MES17
	CALLS	#1,MDMESS	; 'no '
GL54:	PUSHAL	MES18
	CALLS	#1,MDMESS	; 'arguments'
	CLRL	ARGNO
	MOVL	#4,INSW
	MOVL	ARGPT,DBUGPT
PALOOP:	CMPL	@ARGPT,ARGNO
	BEQL	PRCT1
	PUSHAL	MES19
	CALLS	#1,MDMESS	; '  $  '
	INCL	ARGNO
	MOVL	ARGNO,R0
	BSBW	PRNUM

	PUSHAL	MES20
	CALLS	#1,MDMESS	; ')  '
	BSBW	SETPTS
	BSBW	PRID
	BRB	PALOOP
PRCT1:	PUSHAL	MES21
	CALLS	#1,MDMESS	; '$called from$'
PRNEXT:	MOVL	STAKPT,R0
	ADDL2	#4,R0

	MOVL	R0,TEMPT
	MOVL	R0,SRCPT
	MOVL	#STAKPT,DSTPT
	MOVL	SRCPT,R1
	MOVL	DSTPT,R2
	MOVC3	#32,(R1),(R2)
	CMPL	MCHLIN,LINECT
	BNEQ	ZZL138
	BRW	PRCT2
ZZL138:
	CMPB	@SPT,#NLREP
	BNEQ	EL19
	MOVL	LINECT,R0
	DECL	R0

	MOVL	R0,LINECT
	CMPL	R0,MCHLIN
	BNEQ	ZZL139
	BRW	PRCT2
ZZL139:
EL19:	PUSHAL	MES22
	CALLS	#1,MDMESS	; 'lines '
	MOVL	MCHLIN,R0
	BSBW	PRNUM

	PUSHAL	MES23
	CALLS	#1,MDMESS	; ' to '
	MOVL	LINECT,R0
	BSBW	PRNUM

	BRW	PRCT3
; In argument
ERARG:	PUSHAL	MES24
	CALLS	#1,MDMESS	; 'argument '
	BRB	ERDL1
; In delimiter
ERDEL:	PUSHAL	MES25
	CALLS	#1,MDMESS	; 'delimiter '
ERDL1:	MOVL	ARGNO,R0
	BSBW	PRNUM

	PUSHAL	MES15
	CALLS	#1,MDMESS	; ' of '
; In operation macro, argument or delimiter
EROP:	MOVL	DBUGPT,ARGPT
	MOVL	DBUGPT,R1
	MOVL	44(R1),DBUGPT
	CMPL	DBUGSW,#5
	BNEQ	ZZL140
	BRW	ERMAC
ZZL140:
	CLRL	CAPSW
	MOVL	DBUGPT,R0
	BSBW	PRNAME

	PUSHAL	MES26
	CALLS	#1,MDMESS	; ' evaluated in$'
	CMPL	DBUGSW,#2
	BNEQ	ZZL141
	BRW	ERMAC
ZZL141:
	BRW	PRNEXT
; In source text
ERPSRC:	PUSHAL	MES27
	CALLS	#1,MDMESS	; 'source text$$$'
	MOVL	ETEMPT,SRCPT
	MOVL	#STAKPT,DSTPT
	MOVL	SRCPT,R1
	MOVL	DSTPT,R2
	MOVC3	#32,(R1),(R2)
	RSB
;
; Subroutine PRERR
;
PRERR:
	PUSHAL	MES28
	CALLS	#1,MDMESS	; '$$$Error(s)$'
; Update count of errors in S5
	MOVL	SVARPT,R0
	SUBL2	#20,R0

	MOVL	R0,LOTEMP
	MOVL	@LOTEMP,R0
	INCL	R0

	MOVL	R0,@LOTEMP
	RSB
;
; Subroutine PRID
;
PRID:
	TSTL	IDLEN
	BNEQ	EL20
	PUSHAL	MES29
	CALLS	#1,MDMESS	; '(null)'
	BRW	PRIDEX
EL20:	CMPL	IDLEN,#1
	BNEQ	PRID1
; Test if layout character
	MOVL	#2,EXITSW
	BSBW	LULAYK
	BRW	PRID2
	BRB	PRID1
; Print keyword for layout character
PRID2:	MOVL	CHANPT,R1
	MOVL	8(R1),IDLEN
	MOVL	CHANPT,R0
	ADDL2	#12,R0

	MOVL	R0,IDPT
	PUSHAL	MES30
	CALLS	#1,MDMESS	; '('
	BSBW	LOERPR
	PUSHAL	MES31
	CALLS	#1,MDMESS	; ')'
PRIDEX:	RSB
; Print ordinary text
PRID1:	CLRL	TEMPSW
	CMPL	IDLEN,#60
	BLEQ	EL21
	MOVL	#1,TEMPSW
	MOVL	IDPT,R0
	ADDL2	IDLEN,R0

	SUBL2	#26,R0
	MOVL	R0,TEMPT
	MOVL	#26,IDLEN
EL21:	BSBW	LOERPR
	TSTL	TEMPSW
	BNEQ	ZZL142
	BRW	PRIDEX
ZZL142:
	MOVL	TEMPT,IDPT
	PUSHAL	MES32
	CALLS	#1,MDMESS	; '  ---  '
	BRW	PRID1
;
; Subroutine PRLID
;
PRLID:	MOVL	R0,PARNM

	MOVL	R0,TEMAPT
PRL1:	MOVL	TEMAPT,R1
	MOVL	4(R1),IDLEN
	MOVL	TEMAPT,R0
	ADDL2	#8,R0

	MOVL	R0,IDPT
	ADDL2	IDLEN,R0
	MOVL	R0,TEMAPT
	BSBW	PRID
	CMPL	@TEMAPT,WITHMK
	BEQL	PRL1
	CMPL	@TEMAPT,WTHSMK
	BEQL	GL55
	RSB
GL55:	PUSHAL	MES33
	CALLS	#1,MDMESS	; ' '
	BRW	PRL1
;
; Subroutine PRLINO
;
PRLINO:	MOVL	R0,PARNM

	PUSHAL	MES34
	CALLS	#1,MDMESS	; 'line '
	MOVL	PARNM,R0
	BSBW	PRNUM

	RSB
;
; Subroutine PRMISS
;
PRMISS:
	TSTL	NESTLV
	BNEQ	ZZL143
	BRW	PMLAB
ZZL143:
	MOVL	CLLFPT,LFPT
PMDEL:	PUSHAL	MES35
	CALLS	#1,MDMESS	; 'Delimiter '
PMOR:	MOVL	DELPT,R0
	BSBW	PRLID

	MOVL	@DELPT,R0
	MOVL	R0,CHLINK
	TSTL	R0
	BEQL	EL22
	PUSHAL	MES36
	CALLS	#1,MDMESS	; ' or '
	MOVL	DELPT,R0
	ADDL2	CHLINK,R0

	MOVL	R0,DELPT
	BRB	PMOR
EL22:	PUSHAL	MES15
	CALLS	#1,MDMESS	; ' of '
	CLRL	CAPSW
	MOVL	MTCHPT,R0
	BSBW	PRNAME

	MOVL	MCHLIN,R0
	BSBW	PRNFND

	BSBW	DECALV
	BRW	PMD1
	BRW	PMDEL
PMD1:	CLRL	SKIPLV
	TSTL	SKVAL
	BGEQ	PMLAB
	CLRL	R0
	SUBL2	SKVAL,R0

	DECL	R0
	MOVL	R0,SKVAL
PMLAB:	TSTL	SKVAL
	BEQL	PMTHRU
	PUSHAL	MES4
	CALLS	#1,MDMESS	; 'Label '
	MOVL	SKVAL,R0
	BSBW	PRNUM

	PUSHAL	MES37
	CALLS	#1,MDMESS	; ' referenced'
	MOVL	SKLIN,R0
	BSBB	PRNFND

	CLRL	SKVAL
PMTHRU:	BSBW	PRCTXT
	RSB
;
; Subroutine PRNAME
;
PRNAME:	MOVL	R0,PARNM

	MOVL	R0,IDPT
	BSBW	SETYPE
	BSBB	PRTYPE
	PUSHAL	MES33
	CALLS	#1,MDMESS	; ' '
	MOVL	IDPT,R0
	BSBW	PRLID

	RSB
;
; Subroutine PRNFND
;
PRNFND:	MOVL	R0,PARNM

	PUSHAL	MES38
	CALLS	#1,MDMESS	; ' in '
	MOVL	PARNM,R0
	BSBW	PRLINO

	PUSHAL	MES39
	CALLS	#1,MDMESS	; ' of current text not found$'
	RSB
;
; Subroutine PRNUM
;
PRNUM:	MOVL	R0,PARNM

	MOVL	R0,MEVAL
	CALLS	#0,MDCONV
	BSBW	LOERPR
	RSB
;
; Subroutine PRTYPE
;
PRTYPE:
	MOVL	TYPE,R0
	ADDL2	R0,R0

	ADDL2	CAPSW,R0
	MOVL	R0,LOTEMP
	BSBB	ZZL144
ZZL144:	MULL3	#3,LOTEMP,R11
	ADDL2	R11,(SP)
	ADDL2	#15,(SP)
	RSB
	BRW	PRT0
	BRW	PRT0C
	BRW	PRT1
	BRW	PRT1C
	BRW	PRT2
	BRW	PRT2C
	BRW	PRT3
	BRW	PRT3C
	BRW	PRT4
	BRW	PRT4C
PRT0:	PUSHAL	MES40
	CALLS	#1,MDMESS	; 'stop'
	BRW	PREXIT
PRT0C:	PUSHAL	MES41
	CALLS	#1,MDMESS	; 'Stop'
	BRB	PREXIT
PRT1:	PUSHAL	MES42
	CALLS	#1,MDMESS	; 'macro'
	BRB	PREXIT
PRT1C:	PUSHAL	MES43
	CALLS	#1,MDMESS	; 'Macro'
	BRB	PREXIT
PRT2:	PUSHAL	MES44
	CALLS	#1,MDMESS	; 'warning'
	BRB	PREXIT
PRT2C:	PUSHAL	MES45
	CALLS	#1,MDMESS	; 'Warning'
	BRB	PREXIT
PRT3:	PUSHAL	MES46
	CALLS	#1,MDMESS	; 'insert'
	BRB	PREXIT
PRT3C:	PUSHAL	MES47
	CALLS	#1,MDMESS	; 'Insert'
	BRB	PREXIT
PRT4:	PUSHAL	MES48
	CALLS	#1,MDMESS	; 'skip'
	BRB	PREXIT
PRT4C:	PUSHAL	MES49
	CALLS	#1,MDMESS	; 'Skip'
PREXIT:	RSB
;
; Subroutine PRVIZ
;
PRVIZ:
	PUSHAL	MES50
	CALLS	#1,MDMESS	; ', viz '
	MOVB	#QUTREP,R2
	CALLS	#0,MDERCH

	BSBW	PRID
	MOVB	#QUTREP,R2
	CALLS	#0,MDERCH

	BSBW	PRCTXT
	RSB
;
; Subroutine SETYPE
;
SETYPE:	MOVL	R0,PARNM

	ADDL2	#4,R0
	MOVL	R0,TEMAPT
STP1:	MOVL	@TEMAPT,R0
	ADDL2	TEMAPT,R0

	ADDL2	#4,R0
	MOVL	R0,TEMPT
	ADDL2	#4,R0
	MOVL	R0,TEMAPT
	CMPL	@TEMPT,WITHMK
	BEQL	STP1
	CMPL	@TEMPT,WTHSMK
	BEQL	STP1
	CMPL	@TEMPT,SPCSMK
	BNEQ	GL56
	ADDL2	#4,TEMAPT
GL56:	MOVL	@TEMAPT,TYPE
	RSB
;
; Subroutine PRENV
;
PRENV:	MOVL	SVARPT,R1
	TSTL	-72(R1)
	BNEQ	ZZL145
	RSB
ZZL145:

	PUSHAL	MES51
	CALLS	#1,MDMESS	; '$$Version AJB$'
	CLRL	MTYPE
ENV1:	PUSHAL	MES2
	CALLS	#1,MDMESS	; '$'
	CMPL	MTYPE,#5
	BNEQ	GL57
	RSB
GL57:	MOVL	MTYPE,TYPE
	MOVL	#1,CAPSW
	BSBW	PRTYPE
	PUSHAL	MES52
	CALLS	#1,MDMESS	; 's are$$'
	MOVL	HASHPT,R0
	MOVL	R0,PRSTPT
	MOVL	R0,PRTAPT
TAB3:	MOVL	PRTAPT,PRTBPT
TAB1:	MOVL	@PRTBPT,R0
	MOVL	R0,PRTBPT
	TSTL	R0
	BNEQ	ZZL146
	BRW	TAB2
ZZL146:
; Eliminate built-in macros
	CMPL	STFFPT,PRTBPT
	BGTRU	TAB1
	CMPL	PRTBPT,ENDPT
	BGEQU	TAB1
	MOVL	PRTBPT,R0
	ADDL2	#4,R0

	BSBW	SETYPE
	CMPL	TYPE,MTYPE
	BNEQ	TAB1
	TSTL	TYPE
	BEQL	GL58
	MOVL	PRTBPT,R0
	BSBW	CKVALY

	BRW	TAB1
GL58:	MOVL	PRTBPT,R0
	ADDL2	#4,R0

	BSBW	PRLID
	PUSHAL	MES2
	CALLS	#1,MDMESS	; '$'
	BRW	TAB1
TAB2:	ADDL2	#4,PRTAPT
	MOVL	PRTAPT,R0
	SUBL2	PRSTPT,R0

	CMPL	R0,#256
	BNEQ	GL59
	INCL	MTYPE
	BRW	ENV1
GL59:	BRW	TAB3
; End of MI-logic of ML/I
; Special additional code for LOWL ML/I
;
; Subroutine LOSCHN
;
LOSCHN:	MOVL	R0,PARNM

; Corresponds to CHAIN FROM in L
	MOVL	R0,CHANPT
	TSTL	R0
	BEQL	LOS1
	MOVL	@CHANPT,CHLINK
	ADDL2	#3*1,(SP)
	RSB
LOS1:	RSB
;
; Subroutine LOECHN
;
LOECHN:
; Corresponds to ENDCH in L
	TSTL	CHLINK
	BEQL	LOE1
	MOVL	CHLINK,R0
	ADDL2	CHANPT,R0

	MOVL	R0,CHANPT
	MOVL	@CHANPT,CHLINK
	RSB
LOE1:	ADDL2	#3*1,(SP)
	RSB
; Finalisation code
LOHALT:	PUSHAL	MES53
	CALLS	#1,MDMESS	; '$$At end of process: '
	MOVL	SVARPT,R1
	SUBL2	#8,R1
	MOVL	0(R1),R0
	DECL	R0

	MOVL	R0,TEMP
	BSBW	PRNUM
	PUSHAL	MES54
	CALLS	#1,MDMESS	; ' line'
	CMPL	TEMP,#1
	BEQL	LOH1
	PUSHAL	MES55
	CALLS	#1,MDMESS	; 's'
LOH1:	PUSHAL	MES56
	CALLS	#1,MDMESS	; ', '
	MOVL	INVOCT,R0
	BSBW	PRNUM

	PUSHAL	MES57
	CALLS	#1,MDMESS	; ' call'
	CMPL	INVOCT,#1
	BEQL	LOH2
	PUSHAL	MES55
	CALLS	#1,MDMESS	; 's'
LOH2:	PUSHAL	MES2
	CALLS	#1,MDMESS	; '$'
	BSBW	PRENV
	CALLS	#0,MDQUIT
; Code to process BC delimiter on GO macro
LOGOBC:	MOVL	INFFPT,TEMPT
	CLRL	TEMP
	CMPB	@IDPT,#^A\I\
	BEQL	BCI
	CMPB	@IDPT,#^A\L\
	BEQL	BCL
	CMPB	@IDPT,#^A\N\
	BEQL	ZZL147
	BRW	ERLIA
ZZL147:
BCNLP:	CMPB	@TEMPT,#^A\+\
	BEQL	BCN1
	CMPB	@TEMPT,#^A\-\
	BNEQ	BCN2
BCN1:	INCL	TEMPT
	BRB	BCNLP
BCN2:	INCL	TEMP
BCL:	INCL	TEMP
BCI:	CMPL	TEMPT,ERIAPT
	BNEQU	ZZL148
	BRW	GOFAIL
ZZL148:
BCLOOP:	MOVB	@TEMPT,R2
	TSTB	MDPCTAB(R2)
	BEQL	ZZL149
	BRW	GOFAIL
ZZL149:

	TSTL	TEMP
	BEQL	BCOK
	MOVL	#1,IDLEN
	CLRL	MEVAL
	MOVB	@TEMPT,R2
	CVTBL	MDDIGTAB(R2),R0
	BLSS	BCTST

	INCL	IDLEN
BCTST:	CMPL	IDLEN,TEMP
	BEQL	ZZL150
	BRW	GOFAIL
ZZL150:
BCOK:	INCL	TEMPT
	CMPL	TEMPT,ERIAPT
	BNEQU	ZZL151
	BRW	GOSUC
ZZL151:
	BRW	BCLOOP
;
; Subroutine LOERPR
;
LOERPR:
; Prints text in error messages
	MOVL	IDPT,R0
	ADDL2	IDLEN,R0

	MOVL	R0,DSTPT
LOERLP:	CMPL	IDPT,DSTPT
	BGEQU	LOERET
	CMPB	@IDPT,#SLREP
	BEQL	LOERSL
	MOVB	@IDPT,R2
	CALLS	#0,MDERCH

LOER1:	INCL	IDPT
	BRB	LOERLP
LOERSL:	PUSHAL	MES58
	CALLS	#1,MDMESS	; '(SL)'
	BRB	LOER1
LOERET:	RSB
;
; Subroutine LONUM
;
LONUM:
; Performs character to numerical conversion
	MOVB	@IDPT,R2
	CVTBL	MDDIGTAB(R2),R0
	BLSS	NUMEX

	MOVL	R0,MEVAL
	MOVL	IDPT,TEMPT
LNMLP:	INCL	TEMPT
	CMPL	SPT,TEMPT
	BLSSU	NMFIN
	MOVB	@TEMPT,R2
	CVTBL	MDDIGTAB(R2),R0
	BGEQ	ZZL152
	BRW	ERLIA
ZZL152:

	MOVL	R0,TEMP
	MOVL	MEVAL,R0
	MULL2	#10,R0

	ADDL2	TEMP,R0
	MOVL	R0,MEVAL
	BRB	LNMLP
NMFIN:	ADDL2	#3*1,(SP)
	RSB
NUMEX:	RSB
;
	.END
