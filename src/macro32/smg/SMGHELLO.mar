	.TITLE	SMGHELLO	Full-screen SMG window with centered "Hello World"
	.IDENT	/V1.0/

;++
; SMGHELLO.MAR
;
;   Opens a full-screen bordered virtual display on the controlling
;   terminal using the OpenVMS Screen Management (SMG$) run-time
;   library, writes "Hello World" centred inside the window, and
;   blocks on a single keystroke before tearing down and exiting.
;
; Flow:
;   1. SMG$CREATE_PASTEBOARD on SYS$OUTPUT -- the call also reports
;      the physical terminal's row and column counts back to us.
;   2. SMG$CREATE_VIRTUAL_DISPLAY sized (rows-2) x (cols-2) with the
;      SMG$M_BORDER attribute, so that when it is pasted at (2, 2)
;      the border sits exactly on the screen edges.
;   3. SMG$CREATE_VIRTUAL_KEYBOARD on SYS$INPUT (pasteboard must
;      already exist -- see the note in the SMG reference).
;   4. SMG$PASTE_VIRTUAL_DISPLAY at row 2, column 2.
;   5. SMG$PUT_CHARS places "Hello World" at the geometric centre
;      of the display's interior.
;   6. SMG$READ_KEYSTROKE blocks until any key is pressed; the
;      keystroke is consumed silently (not echoed).
;   7. SMG$DELETE_VIRTUAL_DISPLAY then SMG$DELETE_PASTEBOARD.
;
; On any SMG$ failure we return the failing status in R0 without
; attempting cleanup -- image rundown will release the pasteboard.
;
; References consulted (all in this repo):
;   reference/VAX-VMS-731/rtl-smg.md
;       SMG$CREATE_PASTEBOARD         (pasteboard-id, [output-device],
;                                      [rows], [cols], ...)
;       SMG$CREATE_VIRTUAL_DISPLAY    (rows, cols, display-id,
;                                      [display-attributes], ...)
;       SMG$CREATE_VIRTUAL_KEYBOARD   (keyboard-id, ...)
;       SMG$PASTE_VIRTUAL_DISPLAY     (display-id, pasteboard-id,
;                                      row, column)
;       SMG$PUT_CHARS                 (display-id, text, [start-row],
;                                      [start-column], ...)
;       SMG$READ_KEYSTROKE            (keyboard-id, terminator-code, ...)
;       SMG$DELETE_VIRTUAL_DISPLAY    (display-id)
;       SMG$DELETE_PASTEBOARD         (pasteboard-id, ...)
;       Chapter 7, Example 7-6: "Using SMG$ Routines in VAX MACRO"
;       -- canonical MACRO-32 call sequence for SMG.
;   reference/VAX-VMS-731/vax-macro-ref-2001.md
;       Chapter 9 -- SUBL3 sub,min,dif  =>  dif = min - sub
;                    DIVL3 divr,divd,quo => quo = divd / divr
;
; Build (on OpenVMS):
;   $ MACRO SMGHELLO
;   $ LINK  SMGHELLO                  ! SMG$ routines are in IMAGELIB
;   $ RUN   SMGHELLO
;--

	$SMGDEF					; SMG$M_BORDER, SMG$K_*, ...

	HELLO_LEN = 11				; Length of "Hello World"
	SS_NORMAL = 1				; SS$_NORMAL low bit = success

;
; External routines
;
	.EXTRN	SMG$CREATE_PASTEBOARD
	.EXTRN	SMG$CREATE_VIRTUAL_DISPLAY
	.EXTRN	SMG$CREATE_VIRTUAL_KEYBOARD
	.EXTRN	SMG$PASTE_VIRTUAL_DISPLAY
	.EXTRN	SMG$PUT_CHARS
	.EXTRN	SMG$READ_KEYSTROKE
	.EXTRN	SMG$DELETE_VIRTUAL_DISPLAY
	.EXTRN	SMG$DELETE_PASTEBOARD

;
; Read/write data
;
	.PSECT	SMGHELLO_DATA, NOEXE, WRT, LONG

; .ASCID lays down an 8-byte string descriptor (length/class/type/
; pointer) immediately followed by the string bytes. MSG labels the
; descriptor, which is what SMG$PUT_CHARS expects by reference.
MSG:	.ASCID	/Hello World/

	.ALIGN	LONG
PB_ID:		.BLKL	1		; Pasteboard id
PB_ROWS:	.BLKL	1		; Terminal row count    (out of CREATE_PASTEBOARD)
PB_COLS:	.BLKL	1		; Terminal column count (out of CREATE_PASTEBOARD)
DISP_ID:	.BLKL	1		; Virtual display id
KB_ID:		.BLKL	1		; Virtual keyboard id
DISP_ROWS:	.BLKL	1		; Display interior rows    = PB_ROWS - 2
DISP_COLS:	.BLKL	1		; Display interior columns = PB_COLS - 2
MSG_ROW:	.BLKL	1		; Row at which to place "Hello World"
MSG_COL:	.BLKL	1		; Starting column for "Hello World"

PASTE_ROW:	.LONG	2		; Paste at (2, 2) -- border on row 1/PB_ROWS
PASTE_COL:	.LONG	2		;                    and col 1/PB_COLS
DISP_ATTR:	.LONG	SMG$M_BORDER	; Request a bordered display

	.ALIGN	LONG
TERM_CODE:	.BLKW	1		; Keystroke terminator (out of READ_KEYSTROKE)

;
; Executable code
;
	.PSECT	SMGHELLO_CODE, EXE, NOWRT, LONG

	.ENTRY	SMGHELLO, ^M<>

;
; 1. Create the pasteboard. Passing 0 (NULL) for output-device
;    selects SYS$OUTPUT; the row and column out-arguments receive
;    the terminal's physical dimensions, which we need to size the
;    full-screen display.
;
	PUSHAL	PB_COLS				; number-of-pasteboard-columns (out)
	PUSHAL	PB_ROWS				; number-of-pasteboard-rows    (out)
	CLRL	-(SP)				; output-device -- NULL = SYS$OUTPUT
	PUSHAL	PB_ID				; pasteboard-id (out)
	CALLS	#4, G^SMG$CREATE_PASTEBOARD
	BLBS	R0, 1$
	RET					; BLBC is byte-range only, so after each
1$:						; CALLS we invert to BLBS and inline RET
						; to propagate R0 as exit status.

;
; 2. Compute the display's interior dimensions (2 rows/cols smaller
;    than the terminal so the border sits on the physical edge).
;
	SUBL3	#2, PB_ROWS, DISP_ROWS		; DISP_ROWS = PB_ROWS - 2
	SUBL3	#2, PB_COLS, DISP_COLS		; DISP_COLS = PB_COLS - 2

;
; 3. Work out where to place the text.
;
;    Vertical centre:  MSG_ROW = (DISP_ROWS + 1) / 2
;    Horizontal:       MSG_COL = (DISP_COLS - HELLO_LEN) / 2 + 1
;
;    Rows and columns inside the virtual display are 1-based.
;
	ADDL3	#1, DISP_ROWS, R0
	DIVL3	#2, R0, MSG_ROW

	SUBL3	#HELLO_LEN, DISP_COLS, R0
	DIVL2	#2, R0
	INCL	R0
	MOVL	R0, MSG_COL

;
; 4. Create the bordered virtual display at that interior size.
;
	PUSHAL	DISP_ATTR			; display-attributes = SMG$M_BORDER
	PUSHAL	DISP_ID				; display-id (out)
	PUSHAL	DISP_COLS			; number-of-columns
	PUSHAL	DISP_ROWS			; number-of-rows
	CALLS	#4, G^SMG$CREATE_VIRTUAL_DISPLAY
	BLBS	R0, 2$
	RET
2$:

;
; 5. Create the virtual keyboard on SYS$INPUT.
;    NOTE: SMG$CREATE_PASTEBOARD must be called before
;    SMG$CREATE_VIRTUAL_KEYBOARD -- see rtl-smg.md.
;
	PUSHAL	KB_ID				; keyboard-id (out)
	CALLS	#1, G^SMG$CREATE_VIRTUAL_KEYBOARD
	BLBS	R0, 3$
	RET
3$:

;
; 6. Paste the virtual display at (2, 2) so its border hugs the
;    terminal edges on rows 1 / PB_ROWS and columns 1 / PB_COLS.
;
	PUSHAL	PASTE_COL			; column
	PUSHAL	PASTE_ROW			; row
	PUSHAL	PB_ID				; pasteboard-id
	PUSHAL	DISP_ID				; display-id
	CALLS	#4, G^SMG$PASTE_VIRTUAL_DISPLAY
	BLBS	R0, 4$
	RET
4$:

;
; 7. Write "Hello World" centred in the display interior.
;
	PUSHAL	MSG_COL				; start-column
	PUSHAL	MSG_ROW				; start-row
	PUSHAL	MSG				; text (descriptor)
	PUSHAL	DISP_ID				; display-id
	CALLS	#4, G^SMG$PUT_CHARS
	BLBS	R0, 5$
	RET
5$:

;
; 8. Block until any key is pressed. Only the two required
;    arguments are supplied -- no prompt, no timeout, no attached
;    display -- so the keystroke is silently consumed.
;
	PUSHAL	TERM_CODE			; word-terminator-code (out)
	PUSHAL	KB_ID				; keyboard-id
	CALLS	#2, G^SMG$READ_KEYSTROKE
	BLBS	R0, 6$
	RET
6$:

;
; 9. Tear down on the success path. Deleting the pasteboard
;    restores the terminal to its pre-SMG appearance.
;
	PUSHAL	DISP_ID
	CALLS	#1, G^SMG$DELETE_VIRTUAL_DISPLAY

	PUSHAL	PB_ID
	CALLS	#1, G^SMG$DELETE_PASTEBOARD

	MOVL	#SS_NORMAL, R0			; SS$_NORMAL
	RET

	.END	SMGHELLO
