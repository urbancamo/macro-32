	.TITLE	STRANGER  W/A/T encounter menu, leader priority, reaction test
	.IDENT	/V0.1/

;++
; STRANGER.MAR
;
; Public:
;   STRANGER_ENCOUNTER  --  no args.  Reads CHAMBER's SLOT_S/NS,
;                           runs the full W/A/T loop until the
;                           encounter is resolved.
;
; Resolution paths:
;   W -- Withdraw: move party back to SCAVE_MAP_PP, leave the
;        strangers + treasure in the chamber, end turn.
;   A -- Attack:  call DO_ATTACK (simplified single-round combat).
;        Surprise = +1 to us.
;   T -- Test:    roll die for the leader, look up reaction table.
;                 hostile  -> DO_ATTACK with surprise = -1
;                 indiff   -> end turn (Stage 4 v1: simple counter)
;                 friendly -> add all strangers to party as allies
;                             and pick up treasure
;--

	$SSDEF
	$DSCDEF

	.EXTRN	SMG$PUT_CHARS

	.EXTRN	BEGIN_BATCH
	.EXTRN	END_BATCH
	.EXTRN	ERASE_MAIN
	.EXTRN	ERASE_ROW
	.EXTRN	PAINT_CENTERED
	.EXTRN	PAINT_AT_MAIN
	.EXTRN	READ_KEY
	.EXTRN	SCAVE_UI_DSP_MAP

	.EXTRN	ROLL_DIE

	.EXTRN	SCAVE_MAP_PA
	.EXTRN	SCAVE_MAP_PL
	.EXTRN	SCAVE_MAP_PP
	.EXTRN	SCAVE_AREA_AF
	.EXTRN	SCAVE_AREA_AI
	.EXTRN	SCAVE_PARTY_NP
	.EXTRN	SCAVE_PARTY_PC
	.EXTRN	SCAVE_PARTY_PS
	.EXTRN	SCAVE_PARTY_PK
	.EXTRN	SCAVE_PARTY_PT
	.EXTRN	SCAVE_STATE_NC
	.EXTRN	SCAVE_FIGHT_FS

	; Per-area flag bit declared in STATE.MAR.
	SCAVE$M_AF_PERMINDIFF = ^X10

	; Per-creature treasure backing slots -- MUST match STATE.MAR's
	; SCAVE$_TREAS_PER (file-local `=` constants don't cross modules).
	SCAVE$_TREAS_PER = 20

	.EXTRN	SCAVE_DATA_CR_NAME_PTR
	.EXTRN	SCAVE_DATA_CR_LEADER_PRI
	.EXTRN	SCAVE_DATA_CR_HOSTILE_MAX
	.EXTRN	SCAVE_DATA_CR_INDIFF_MAX

	; Combat resolution lives in FIGHT.MAR.
	.EXTRN	DO_FIGHT

;
; STATE.MAR per-chamber working set (filled by CHAMBER.MAR).
;
	.EXTRN	SCAVE_CHAMBER_NS
	.EXTRN	SCAVE_CHAMBER_CS
	.EXTRN	SCAVE_STATE_GS


	.PSECT	SCAVE_STRANGER_DATA, NOEXE, WRT, LONG

	.ALIGN	LONG
ROW_TMP:	.BLKL	1
LEADER_IDX:	.LONG	0			; index of strongest stranger leader

;
; Static prompts/messages.
;
DSC_PROMPT_WAT:		.ASCID	/[W]ithdraw    [A]ttack    [T]est reaction/
DSC_TESTING:		.ASCID	/Testing the leader's reaction.../
DSC_HOSTILE:		.ASCID	/HOSTILE!  They attack with surprise./
DSC_INDIFF:		.ASCID	/Indifferent.  They watch you warily./
DSC_PERM_INDIFF:	.ASCID	/Permanently indifferent.  They cannot be tested again./
DSC_FRIENDLY:		.ASCID	/Friendly!  They join your party./
DSC_WITHDRAW:		.ASCID	/You withdraw the way you came./


	.PSECT	SCAVE_STRANGER_CODE, EXE, NOWRT, LONG

;
; ===========================================================
;  STRANGER_ENCOUNTER  --  loops until the encounter is resolved
;                          (withdraw / attack / friendly recruit
;                          / indifferent end-of-turn).
; ===========================================================
;
	.ENTRY	STRANGER_ENCOUNTER, ^M<R2,R3,R4,R5,R6,R7,R8>

	BSBW	FIND_LEADER

E_LOOP:
	; The chamber-intro screen has already painted the strangers;
	; just paint the prompt at row 17 and wait.
	MOVL	#17, ROW_TMP
	PUSHAL	ROW_TMP
	PUSHAL	DSC_PROMPT_WAT
	CALLS	#2, G^PAINT_CENTERED

	CALLS	#0, G^READ_KEY
	MOVL	R0, R6				; key

	CMPL	R6, #^A/W/
	BEQL	E_WITHDRAW
	CMPL	R6, #^A/w/
	BEQL	E_WITHDRAW
	CMPL	R6, #^A/A/
	BEQL	E_ATTACK
	CMPL	R6, #^A/a/
	BEQL	E_ATTACK
	CMPL	R6, #^A/T/
	BEQL	E_TEST
	CMPL	R6, #^A/t/
	BEQL	E_TEST
	BRB	E_LOOP

E_WITHDRAW:
	MOVAB	DSC_WITHDRAW, R5
	BSBW	PAINT_RESULT_LINE
	CALLS	#0, G^READ_KEY

	; Move party back to PP.  PP was set by TRY_MOVE before the
	; chamber dispatch.  Keep level as-is (PP is on the same level
	; for normal moves; for stairs the level update is more involved
	; and we simplify Stage 4).
	MOVL	SCAVE_MAP_PP, R0
	BEQL	1$				; no PP -- shouldn't happen
	MOVL	R0, SCAVE_MAP_PA
1$:	MOVL	#SS$_NORMAL, R0
	RET


E_ATTACK:
	MOVL	#1, SCAVE_FIGHT_FS		; we have surprise
	CALLS	#0, G^DO_FIGHT
	MOVL	#SS$_NORMAL, R0
	RET


E_TEST:
	; If a previous visit's third indifferent roll set the perm-indiff
	; flag, the rules say the strangers can never be tested again.
	; Short-circuit to a single "you can't test them" message and end
	; turn -- the chamber-intro screen has already painted them, so
	; there's nothing else to redraw.
	MOVL	SCAVE_MAP_PA, R0
	BBC	#4, SCAVE_AREA_AF[R0], 5$	; bit 4 = AF_PERMINDIFF
	MOVAB	DSC_PERM_INDIFF, R5
	BSBW	PAINT_RESULT_LINE
	CALLS	#0, G^READ_KEY
	MOVL	#SS$_NORMAL, R0
	RET
5$:

	MOVAB	DSC_TESTING, R5
	BSBW	PAINT_RESULT_LINE

	CALLS	#0, G^ROLL_DIE			; R0 = 1..6 raw roll
	MOVL	R0, R5				; R5 = roll

	; Modifiers per the rules: +1 if any HERO or W-HERO in party,
	; -NC for curses.  A raw 1 always counts as 1 (hostile) -- we
	; check that AFTER applying the modifiers.
	BSBW	HAS_CHARISMA
	TSTL	R0
	BEQL	1$
	INCL	R5
1$:
	SUBL2	SCAVE_STATE_NC, R5
	; Clamp to [1..6]
	CMPL	R5, #1
	BGEQ	2$
	MOVL	#1, R5
2$:	CMPL	R5, #6
	BLEQ	3$
	MOVL	#6, R5
3$:
	; If the raw roll was 1 the result is hostile regardless.
	CMPL	R0, #1
	BNEQ	4$
	MOVL	#1, R5				; force result roll to 1 (hostile)
4$:

	; Look up tables[leader].
	MOVL	LEADER_IDX, R2
	MOVAB	SCAVE_DATA_CR_HOSTILE_MAX, R3
	MOVL	(R3)[R2], R3			; R3 = hostile_max
	MOVAB	SCAVE_DATA_CR_INDIFF_MAX, R4
	MOVL	(R4)[R2], R4			; R4 = indiff_max

	CMPL	R5, R3
	BGTR	NOT_HOSTILE
	; Hostile path
	MOVAB	DSC_HOSTILE, R5
	BSBW	PAINT_RESULT_LINE
	CALLS	#0, G^READ_KEY
	MNEGL	#1, SCAVE_FIGHT_FS		; strangers have surprise
	CALLS	#0, G^DO_FIGHT
	MOVL	#SS$_NORMAL, R0
	RET

NOT_HOSTILE:
	CMPL	R5, R4
	BGTR	FRIENDLY
	; Indifferent path.  Bump this area's indiff counter; on the
	; third indifferent test set AF_PERMINDIFF so future visits
	; can't test the strangers again (per the rules).  Use a custom
	; message on the third hit so the player knows the door has
	; closed.
	MOVL	SCAVE_MAP_PA, R0
	INCL	SCAVE_AREA_AI[R0]
	CMPL	SCAVE_AREA_AI[R0], #3
	BLSS	1$
	BISL2	#SCAVE$M_AF_PERMINDIFF, SCAVE_AREA_AF[R0]
	MOVAB	DSC_PERM_INDIFF, R5
	BRB	2$
1$:	MOVAB	DSC_INDIFF, R5
2$:
	BSBW	PAINT_RESULT_LINE
	CALLS	#0, G^READ_KEY
	MOVL	#SS$_NORMAL, R0
	RET

FRIENDLY:
	MOVAB	DSC_FRIENDLY, R5
	BSBW	PAINT_RESULT_LINE
	CALLS	#0, G^READ_KEY

	BSBW	ADD_FRIENDLIES_TO_PARTY
	MOVL	#SS$_NORMAL, R0
	RET


;
; ===========================================================
;  FIND_LEADER  --  fills LEADER_IDX with the priority-winning
;                   creature index from SLOT_S[0..NS-1].
; ===========================================================
;
FIND_LEADER:
	MOVAB	SCAVE_CHAMBER_NS, R0
	MOVL	(R0), R3			; R3 = NS
	MOVAB	SCAVE_CHAMBER_CS, R4			; R4 = SLOT_S base
	MOVAB	SCAVE_DATA_CR_LEADER_PRI, R5

	; Default: LEADER_IDX = SLOT_S[0]; best_pri = pri[that]
	MOVL	(R4), R0			; first stranger creature index
	MOVL	R0, LEADER_IDX
	MOVL	(R5)[R0], R6			; R6 = best priority

	MOVL	#1, R2				; iter index
FL_LOOP:
	CMPL	R2, R3
	BLSS	FL_BODY
	RSB
FL_BODY:
	MOVL	(R4)[R2], R0			; creature index of slot R2
	MOVL	(R5)[R0], R1			; its priority
	CMPL	R1, R6
	BLEQ	FL_NEXT
	MOVL	R1, R6				; new best
	MOVL	R0, LEADER_IDX
FL_NEXT:
	INCL	R2
	BRB	FL_LOOP


;
; HAS_CHARISMA -- R0 = 1 if any party member is HERO (0) or
;                 W-HERO (1) and PS != STONE/DEAD; 0 otherwise.
;
HAS_CHARISMA:
	CLRL	R0				; default no
	CLRL	R2				; party slot
HC_LOOP:
	CMPL	R2, SCAVE_PARTY_NP
	BLSS	HC_BODY
	RSB
HC_BODY:
	MOVL	SCAVE_PARTY_PS[R2], R1
	CMPL	R1, #2				; STONE
	BGEQ	HC_NEXT
	MOVL	SCAVE_PARTY_PC[R2], R1
	CMPL	R1, #1
	BGTR	HC_NEXT				; not HERO/W-HERO
	MOVL	#1, R0
	RSB
HC_NEXT:
	INCL	R2
	BRB	HC_LOOP


;
; ADD_FRIENDLIES_TO_PARTY -- append each entry of SLOT_S to the
; party with PS=ALLY.  Also clear NS so the chamber treats the
; strangers as gone.
;
ADD_FRIENDLIES_TO_PARTY:
	MOVAB	SCAVE_CHAMBER_NS, R0
	MOVL	(R0), R3			; R3 = NS
	BEQL	AF_DONE
	MOVAB	SCAVE_CHAMBER_CS, R4
	CLRL	R2
AF_LOOP:
	CMPL	R2, R3
	BLSS	AF_BODY
	BRB	AF_DONE
AF_BODY:
	MOVL	SCAVE_PARTY_NP, R5
	CMPL	R5, #12				; party-size cap
	BGEQ	AF_DONE				; party full
	MOVL	(R4)[R2], R6			; creature index
	MOVL	R6, SCAVE_PARTY_PC[R5]
	MOVL	#1, SCAVE_PARTY_PS[R5]		; ALLY
	CLRL	SCAVE_PARTY_PK[R5]
	; Clear this ally's treasure slots (SCAVE$_TREAS_PER of them).
	MULL3	#SCAVE$_TREAS_PER, R5, R0
	MNEGL	#1, R1
	MOVL	#SCAVE$_TREAS_PER, R7
1$:	MOVL	R1, SCAVE_PARTY_PT[R0]
	INCL	R0
	SOBGTR	R7, 1$
	INCL	SCAVE_PARTY_NP
	INCL	R2
	BRB	AF_LOOP
AF_DONE:
	; Clear stranger count.
	MOVAB	SCAVE_CHAMBER_NS, R0
	CLRL	(R0)
	RSB


;
; ===========================================================
;  PAINT_RESULT_LINE  --  R5 = address of a string descriptor.
;                         Erases row 15 (the encounter "result"
;                         row) before painting so a shorter
;                         message doesn't get tail-garbled by
;                         leftover characters from an earlier
;                         frame on the same row.
;
;   Combat itself moved to FIGHT.MAR's DO_FIGHT -- this module
;   only handles the W/A/T menu and reaction test; once it's
;   decided to start a fight it CALLS DO_FIGHT.
; ===========================================================
;
PAINT_RESULT_LINE:
	MOVL	#15, ROW_TMP
	PUSHAL	ROW_TMP
	CALLS	#1, G^ERASE_ROW
	PUSHAL	ROW_TMP
	PUSHL	R5
	CALLS	#2, G^PAINT_CENTERED
	RSB

	.END
