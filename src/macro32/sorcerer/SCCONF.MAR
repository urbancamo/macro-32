	.TITLE	SCCONF	Conformance-vector replayer for The Sorcerer's Cave
	.IDENT	/V0.1/

;++
; SCCONF.MAR
;
;   Headless replayer for the reference engine's conformance vectors
;   (engine-spec Appendix D; format in docs/specs/conformance/
;   README.md of the reference repo).  Reads CONFVEC.TXT from the
;   default directory, drives the engine through ENG_NEWGAME /
;   ENG_APPLY, and writes CONFRES.TXT in EXACTLY the vector format,
;   so a host-side diff against the reference file pinpoints the
;   first divergent line (make vms-scave-conform).
;
;   Line handling:
;     echoed verbatim   titles, SEED, PICKS, BEGIN/END MOVES, END
;     computed by us    SETUP, per-move checkpoints (text left of
;                       "->" is echoed, the rest computed), FINAL,
;                       STATE, PARTY (all members), AREA (all areas)
;
;   Status: G0.  ENG_APPLY is a stub, so every checkpoint after
;   SETUP repeats the newGame state with EV - ; that is the honest
;   divergence the conformance gates then burn down.
;--

	$SSDEF
	$RMSDEF
	$DSCDEF

	SCAVE$_PARTY_MAX = 12
	SCAVE$_TREAS_PER = 20			; must equal STATE.MAR's value
	SCAVE$_AREA_ITEMS = 8

	MAXPICKS = 8
	LINEMAX  = 256

;
; ===========================================================
;  Data
; ===========================================================
;
	.PSECT	SCCONF_DATA, NOEXE, WRT, LONG

	.ALIGN	LONG
IN_FAB:	$FAB	FNM=<CONFVEC.TXT>, FAC=GET
	.ALIGN	LONG
IN_RAB:	$RAB	FAB=IN_FAB, RAC=SEQ, UBF=INBUF, USZ=LINEMAX

	.ALIGN	LONG
OUT_FAB: $FAB	FNM=<CONFRES.TXT>, FAC=PUT, RFM=VAR, RAT=CR
	.ALIGN	LONG
OUT_RAB: $RAB	FAB=OUT_FAB, RAC=SEQ, RBF=OUTBUF

INBUF:	.BLKB	LINEMAX
OUTBUF:	.BLKB	LINEMAX
INTBUF:	.BLKB	16

	.ALIGN	LONG
LINELEN: .LONG	0				; current input-line length
OUTPOS:	.LONG	0				; append cursor into OUTBUF
V_SEED:	.LONG	0				; parsed SEED value
NPICKS:	.LONG	0
PICKS:	.BLKL	MAXPICKS
DIDP:	.LONG	0				; emitted our PARTY block
DIDA:	.LONG	0				; emitted our AREA block
TMPN:	.LONG	0				; scratch list for EMIT_LIST
TMPLIST: .BLKL	40

	.ALIGN	LONG
FAOLEN:	.WORD	0
	.ALIGN	LONG
FAODSC:	.WORD	LINEMAX				; runtime len = room left
	.BYTE	DSC$K_DTYPE_T
	.BYTE	DSC$K_CLASS_S
	.ADDRESS OUTBUF				; runtime ptr = OUTBUF+OUTPOS
	.ALIGN	LONG
INTDSC:	.WORD	16
	.BYTE	DSC$K_DTYPE_T
	.BYTE	DSC$K_CLASS_S
	.ADDRESS INTBUF

; FAO control strings.
CTL_SETUP: .ASCID /SETUP TRN !SL LVL !SL ARA !SL PH !AS GS !SL SEED !SL LARGEIDX !SL SMALLIDX !SL/
CTL_CHKPT: .ASCID /TRN !SL LVL !SL ARA !SL PH !AS GS !SL SEED !SL EV /
CTL_FINAL: .ASCID /FINAL GS !SL PH !AS TRN !SL LVL !SL AREAS !SL LARGEIDX !SL SMALLIDX !SL SEED !SL SCORE !SL/
CTL_STATE: .ASCID /STATE CURSES !SL BONUS !SL SORCKILLED !SL STRANGERS /
CTL_PARTY: .ASCID /PARTY !SL CID !SL ST !SL DK !SL CARRY /
CTL_AREA:  .ASCID /AREA !SL CARD !SL COORD !SL FU 1 VIS !SL FLG !SL MIR 0 SD - CONT /
CTL_INT:   .ASCID /!SL/

; Phase names, indexed by SCAVE_STATE_PH (SC-4-3).
PH_EXP_D: .ASCID /EXP/
PH_ENC_D: .ASCID /ENC/
PH_FGT_D: .ASCID /FGT/
PH_PKP_D: .ASCID /PKP/
PH_END_D: .ASCID /END/
	.ALIGN	LONG
PH_TAB:	.ADDRESS PH_EXP_D, PH_ENC_D, PH_FGT_D, PH_PKP_D, PH_END_D

; Literal fragments.
LIT_SEED:  .ASCII	/SEED /
LIT_PICKS: .ASCII	/PICKS/
LIT_SETUP: .ASCII	/SETUP/
LIT_BEGIN: .ASCII	/BEGIN/
LIT_END:   .ASCII	/END/
LIT_FINAL: .ASCII	/FINAL/
LIT_STATE: .ASCII	/STATE/
LIT_PARTY: .ASCII	/PARTY/
LIT_AREA:  .ASCII	/AREA /
LIT_TREAS: .ASCII	/ TREASURES /
	LIT_TREAS_L = . - LIT_TREAS
LIT_HAZ:   .ASCII	/ HAZARDS /
	LIT_HAZ_L = . - LIT_HAZ
LIT_BORNE: .ASCII	/ BORNE -/
	LIT_BORNE_L = . - LIT_BORNE
LIT_DROP:  .ASCII	/ DROP -/
	LIT_DROP_L = . - LIT_DROP
LIT_DASH:  .ASCII	/-/
LIT_COMMA: .ASCII	/,/

;
; ===========================================================
;  Code
; ===========================================================
;
	.PSECT	SCCONF_CODE, EXE, NOWRT, LONG

	.ENTRY	SCCONF, ^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>

	$OPEN	FAB=IN_FAB
	BLBS	R0, 1$
	BRW	DONE
1$:	$CONNECT RAB=IN_RAB
	BLBS	R0, 2$
	BRW	DONE
2$:	$CREATE	FAB=OUT_FAB
	BLBS	R0, 3$
	BRW	DONE
3$:	$CONNECT RAB=OUT_RAB
	BLBS	R0, 4$
	BRW	DONE
4$:

	CLRL	DIDP
	CLRL	DIDA

;
; -- main line loop --------------------------------------------------
;
LINE_LOOP:
	$GET	RAB=IN_RAB
	CMPL	R0, #RMS$_EOF
	BNEQ	5$
	BRW	CLOSE_UP
5$:	BLBS	R0, 6$
	BRW	DONE
6$:	MOVZWL	IN_RAB+RAB$W_RSZ, R0
	MOVL	R0, LINELEN
	CLRL	OUTPOS

	; ---- dispatch on the leading token ----

	; move line?  starts with a space (step numbers are
	; right-justified in a 4-char field)
	CMPL	LINELEN, #10
	BLSS	10$
	CMPB	INBUF, #^A/ /
	BNEQ	10$
	BRW	DO_MOVE
10$:
	CMPL	LINELEN, #5
	BGEQ	12$
	BRW	90$				; short: echo (e.g. "END")
12$:
	CMPC3	#5, INBUF, LIT_SEED		; "SEED "
	BNEQ	20$
	BRW	DO_SEED
20$:	CMPC3	#5, INBUF, LIT_PICKS		; "PICKS"
	BNEQ	30$
	BRW	DO_PICKS
30$:	CMPC3	#5, INBUF, LIT_SETUP		; "SETUP"
	BNEQ	40$
	BRW	DO_SETUP
40$:	CMPC3	#5, INBUF, LIT_FINAL		; "FINAL"
	BNEQ	50$
	BRW	DO_FINAL
50$:	CMPC3	#5, INBUF, LIT_STATE		; "STATE"
	BNEQ	60$
	BRW	DO_STATE
60$:	CMPC3	#5, INBUF, LIT_PARTY		; "PARTY"
	BNEQ	70$
	BRW	DO_PARTY
70$:	CMPC3	#5, INBUF, LIT_AREA		; "AREA "
	BNEQ	90$
	BRW	DO_AREA
90$:
	; default: echo the input line verbatim
	BSBW	ECHO_LINE
	BRW	LINE_LOOP

;
; -- SEED n : remember n, echo ---------------------------------------
;
DO_SEED:
	MOVAB	INBUF+5, R6
	MOVL	LINELEN, R7
	SUBL2	#5, R7
	BSBW	PARSE_UINT
	MOVL	R0, V_SEED
	BSBW	ECHO_LINE
	BRW	LINE_LOOP

;
; -- PICKS a,b,... : parse ids, echo, then start the game ------------
;
DO_PICKS:
	MOVAB	INBUF+6, R6
	MOVL	LINELEN, R7
	SUBL2	#6, R7
	CLRL	R8				; pick count
15$:	BSBW	PARSE_UINT
	TSTL	R1				; digits seen?
	BEQL	25$
	MOVL	R0, PICKS[R8]
	INCL	R8
	CMPL	R8, #MAXPICKS
	BGEQ	25$
	TSTL	R7				; anything left?
	BLEQ	25$
	CMPB	(R6), #^A/,/
	BNEQ	25$
	INCL	R6				; past the comma
	DECL	R7
	BRB	15$
25$:	MOVL	R8, NPICKS
	BSBW	ECHO_LINE

	PUSHAL	PICKS				; picks base
	PUSHL	NPICKS
	PUSHL	V_SEED
	CALLS	#3, G^ENG_NEWGAME
	BRW	LINE_LOOP

;
; -- SETUP : emit our own line ---------------------------------------
;
DO_SETUP:
	SUBL3	#1, SCAVE_MAP_PA, R2		; ARA is 0-based (engine)
	PUSHL	SCAVE_DECK_SI			; SMALLIDX
	PUSHL	SCAVE_DECK_LI			; LARGEIDX
	PUSHL	SCAVE_RNG_SEED			; SEED
	PUSHL	SCAVE_STATE_GS			; GS
	MOVL	SCAVE_STATE_PH, R3
	PUSHL	PH_TAB[R3]			; PH descriptor address
	PUSHL	R2				; ARA
	PUSHL	SCAVE_MAP_PL			; LVL
	PUSHL	SCAVE_STATE_TN			; TRN
	PUSHAQ	FAODSC
	PUSHAW	FAOLEN
	PUSHAQ	CTL_SETUP
	BSBW	FAO_AT_POS_8
	BSBW	PUT_LINE
	BRW	LINE_LOOP

;
; -- move line : echo through "-> ", apply, emit checkpoint ----------
;
DO_MOVE:
	; find "->" in the line
	CLRL	R2
35$:	ADDL3	#1, R2, R3
	CMPL	R3, LINELEN
	BGEQ	45$				; no arrow: echo whole line
	CMPB	INBUF[R2], #^A/-/
	BNEQ	37$
	CMPB	INBUF[R3], #^A/>/
	BEQL	55$
37$:	INCL	R2
	BRB	35$
45$:	BSBW	ECHO_LINE
	BRW	LINE_LOOP
55$:	ADDL2	#3, R2				; include "-> "
	MOVAB	INBUF, R6
	MOVL	R2, R7
	BSBW	APPEND				; echo prefix into OUTBUF

	; G0: apply the action as a stub (no parsing yet; the real
	; action decode lands with gate G2).
	PUSHL	#0
	PUSHL	#0
	PUSHL	#0
	PUSHL	#0
	CALLS	#4, G^ENG_APPLY

	; checkpoint: TRN LVL ARA PH GS SEED EV <events>
	SUBL3	#1, SCAVE_MAP_PA, R2
	PUSHL	SCAVE_RNG_SEED
	PUSHL	SCAVE_STATE_GS
	MOVL	SCAVE_STATE_PH, R3
	PUSHL	PH_TAB[R3]
	PUSHL	R2
	PUSHL	SCAVE_MAP_PL
	PUSHL	SCAVE_STATE_TN
	PUSHAQ	FAODSC
	PUSHAW	FAOLEN
	PUSHAQ	CTL_CHKPT
	BSBW	FAO_AT_POS_6

	; event list: no event-name table yet (G0) -- queue is
	; always empty, print the "-" placeholder
	MOVAB	LIT_DASH, R6
	MOVL	#1, R7
	BSBW	APPEND
	BSBW	PUT_LINE
	BRW	LINE_LOOP

;
; -- FINAL -----------------------------------------------------------
;
DO_FINAL:
	PUSHL	SCAVE_STATE_SC			; SCORE (G0: raw field)
	PUSHL	SCAVE_RNG_SEED
	PUSHL	SCAVE_DECK_SI
	PUSHL	SCAVE_DECK_LI
	PUSHL	SCAVE_MAP_NM			; AREAS placed
	PUSHL	SCAVE_MAP_PL
	PUSHL	SCAVE_STATE_TN
	MOVL	SCAVE_STATE_PH, R3
	PUSHL	PH_TAB[R3]
	PUSHL	SCAVE_STATE_GS
	PUSHAQ	FAODSC
	PUSHAW	FAOLEN
	PUSHAQ	CTL_FINAL
	BSBW	FAO_AT_POS_9
	BSBW	PUT_LINE
	BRW	LINE_LOOP

;
; -- STATE -----------------------------------------------------------
;
DO_STATE:
	PUSHL	SCAVE_STATE_SK
	PUSHL	#0				; BONUS (bonusScore: gate G6)
	PUSHL	SCAVE_STATE_NC
	PUSHAQ	FAODSC
	PUSHAW	FAOLEN
	PUSHAQ	CTL_STATE
	BSBW	FAO_AT_POS_3

	MOVAB	SCAVE_CHAMBER_CS, R9		; STRANGERS list
	MOVL	SCAVE_CHAMBER_NS, R10
	BSBW	EMIT_LIST

	MOVAB	LIT_TREAS, R6
	MOVL	#LIT_TREAS_L, R7
	BSBW	APPEND
	MOVAB	SCAVE_CHAMBER_CT, R9
	MOVL	SCAVE_CHAMBER_NT, R10
	BSBW	EMIT_LIST

	MOVAB	LIT_HAZ, R6
	MOVL	#LIT_HAZ_L, R7
	BSBW	APPEND
	MOVAB	SCAVE_CHAMBER_CH, R9
	MOVL	SCAVE_CHAMBER_NH, R10
	BSBW	EMIT_LIST

	BSBW	PUT_LINE
	BRW	LINE_LOOP

;
; -- PARTY : first sighting emits ALL our members --------------------
;
DO_PARTY:
	TSTL	DIDP
	BEQL	65$
	BRW	LINE_LOOP			; already emitted; swallow
65$:	MOVL	#1, DIDP
	CLRL	R8				; member index
PARTY_ONE:
	CMPL	R8, SCAVE_PARTY_NP
	BLSS	66$
	BRW	LINE_LOOP
66$:	CLRL	OUTPOS
	PUSHL	SCAVE_PARTY_PK[R8]		; DK
	PUSHL	SCAVE_PARTY_PS[R8]		; ST
	PUSHL	SCAVE_PARTY_PC[R8]		; CID
	PUSHL	R8				; index
	PUSHAQ	FAODSC
	PUSHAW	FAOLEN
	PUSHAQ	CTL_PARTY
	BSBW	FAO_AT_POS_4

	; CARRY list: non-empty (-1 = empty) slots of this member's
	; PT row, in slot order
	CLRL	TMPN
	MULL3	#SCAVE$_TREAS_PER, R8, R2	; row base index
	CLRL	R3
75$:	ADDL3	R2, R3, R4
	MOVL	SCAVE_PARTY_PT[R4], R5
	CMPL	R5, #-1
	BEQL	76$
	MOVL	TMPN, R4
	MOVL	R5, TMPLIST[R4]
	INCL	TMPN
76$:	AOBLSS	#SCAVE$_TREAS_PER, R3, 75$
	MOVAB	TMPLIST, R9
	MOVL	TMPN, R10
	BSBW	EMIT_LIST

	MOVAB	LIT_BORNE, R6			; BORNE -: setBorne = G6
	MOVL	#LIT_BORNE_L, R7
	BSBW	APPEND
	BSBW	PUT_LINE
	INCL	R8
	BRW	PARTY_ONE

;
; -- AREA : first sighting emits ALL our areas -----------------------
;
DO_AREA:
	TSTL	DIDA
	BEQL	85$
	BRW	LINE_LOOP
85$:	MOVL	#1, DIDA
	CLRL	R8				; 0-based engine index
AREA_ONE:
	CMPL	R8, SCAVE_MAP_NM
	BLSS	86$
	BRW	LINE_LOOP
86$:	CLRL	OUTPOS
	ADDL3	#1, R8, R11			; our slots are 1-based

	; FLG: the engine surfaces only AF_DESTROYED (=4); mask off
	; this port's internal bookkeeping bits
	BICL3	#^C<4>, SCAVE_AREA_AF[R11], R2

	PUSHL	R2				; FLG
	PUSHL	SCAVE_MAP_MV[R11]		; VIS
	PUSHL	SCAVE_MAP_ML[R11]		; COORD
	PUSHL	SCAVE_MAP_MP[R11]		; CARD
	PUSHL	R8				; index
	PUSHAQ	FAODSC
	PUSHAW	FAOLEN
	PUSHAQ	CTL_AREA
	BSBW	FAO_AT_POS_5

	; CONT list: nonzero persisted item codes for this area
	CLRL	TMPN
	MULL3	#SCAVE$_AREA_ITEMS, R11, R2
	CLRL	R3
95$:	ADDL3	R2, R3, R4
	MOVL	SCAVE_AREA_AC[R4], R5
	BEQL	96$
	MOVL	TMPN, R4
	MOVL	R5, TMPLIST[R4]
	INCL	TMPN
96$:	AOBLSS	#SCAVE$_AREA_ITEMS, R3, 95$
	MOVAB	TMPLIST, R9
	MOVL	TMPN, R10
	BSBW	EMIT_LIST

	MOVAB	LIT_DROP, R6			; DROP -: pool model = G6
	MOVL	#LIT_DROP_L, R7
	BSBW	APPEND
	BSBW	PUT_LINE
	INCL	R8
	BRW	AREA_ONE

;
; -- teardown --------------------------------------------------------
;
CLOSE_UP:
	$CLOSE	FAB=IN_FAB
	$CLOSE	FAB=OUT_FAB
	MOVL	#SS$_NORMAL, R0
DONE:	RET

;
; ===========================================================
;  Helpers (JSB linkage)
; ===========================================================
;

;
;  PARSE_UINT -- R6 = text ptr, R7 = bytes remaining (both updated).
;  Skips leading spaces, accumulates decimal digits.
;  Returns R0 = value, R1 = digit count.
;
PARSE_UINT:
	CLRL	R0
	CLRL	R1
10$:	TSTL	R7
	BLEQ	40$
	CMPB	(R6), #^A/ /
	BNEQ	20$
	INCL	R6
	DECL	R7
	BRB	10$
20$:	TSTL	R7
	BLEQ	40$
	CMPB	(R6), #^A/0/
	BLSSU	40$
	CMPB	(R6), #^A/9/
	BGTRU	40$
	MULL2	#10, R0
	MOVZBL	(R6)+, R2
	SUBL2	#^A/0/, R2
	ADDL2	R2, R0
	INCL	R1
	DECL	R7
	BRB	20$
40$:	RSB

;
;  APPEND -- copy R7 bytes at (R6) to OUTBUF+OUTPOS; OUTPOS += R7.
;
APPEND:
	PUSHR	#^M<R0,R1,R2,R3,R4,R5,R6,R7>
	MOVAB	OUTBUF, R3
	ADDL2	OUTPOS, R3
	MOVC3	R7, (R6), (R3)
	POPR	#^M<R0,R1,R2,R3,R4,R5,R6,R7>
	ADDL2	R7, OUTPOS
	RSB

;
;  FAO_AT_POS_n -- run $FAO with n parameters already on the stack
;  (caller pushed Pn..P1 then outbuf-dsc, outlen-addr, ctrstr-dsc),
;  writing at OUTBUF+OUTPOS; advances OUTPOS.  Implemented as one
;  common tail: the caller's pushes form the CALLS argument list.
;
FAO_AT_POS_3:	MOVL	#6, R2
		BRB	FAO_COMMON
FAO_AT_POS_4:	MOVL	#7, R2
		BRB	FAO_COMMON
FAO_AT_POS_5:	MOVL	#8, R2
		BRB	FAO_COMMON
FAO_AT_POS_6:	MOVL	#9, R2
		BRB	FAO_COMMON
FAO_AT_POS_8:	MOVL	#11, R2
		BRB	FAO_COMMON
FAO_AT_POS_9:	MOVL	#12, R2
		BRB	FAO_COMMON
FAO_COMMON:
	; point the scratch descriptor at the append cursor
	MOVAB	OUTBUF, R3
	ADDL2	OUTPOS, R3
	MOVL	R3, FAODSC+4
	SUBL3	OUTPOS, #LINEMAX, R3
	MOVW	R3, FAODSC
	; the caller left the argument longwords on the stack, below
	; our return address: rotate our RA out, CALLS, come back
	POPL	R3				; our return address
	CALLS	R2, G^SYS$FAO
	MOVZWL	FAOLEN, R2
	ADDL2	R2, OUTPOS
	JMP	(R3)

;
;  EMIT_LIST -- R9 = longword array base, R10 = count.
;  Appends "v1,v2,..." or "-" when empty.
;
EMIT_LIST:
	PUSHR	#^M<R6,R7,R8,R9,R10>
	TSTL	R10
	BNEQ	10$
	MOVAB	LIT_DASH, R6
	MOVL	#1, R7
	BSBW	APPEND
	BRB	90$
10$:	CLRL	R8
20$:	TSTL	R8
	BEQL	30$
	MOVAB	LIT_COMMA, R6
	MOVL	#1, R7
	BSBW	APPEND
30$:	PUSHL	(R9)[R8]			; the value
	PUSHAQ	FAODSC
	PUSHAW	FAOLEN
	PUSHAQ	CTL_INT
	BSBW	FAO_AT_POS_1
	AOBLSS	R10, R8, 20$
90$:	POPR	#^M<R6,R7,R8,R9,R10>
	RSB

FAO_AT_POS_1:	MOVL	#4, R2
		BRW	FAO_COMMON

;
;  ECHO_LINE -- copy the whole input line to OUTBUF and $PUT it.
;
ECHO_LINE:
	MOVAB	INBUF, R6
	MOVL	LINELEN, R7
	CLRL	OUTPOS
	BSBW	APPEND
	; fall through to PUT_LINE

;
;  PUT_LINE -- write OUTBUF[0..OUTPOS-1] as one record.
;
PUT_LINE:
	PUSHR	#^M<R0,R1,R2,R3,R4,R5>
	MOVW	OUTPOS, OUT_RAB+RAB$W_RSZ
	$PUT	RAB=OUT_RAB
	POPR	#^M<R0,R1,R2,R3,R4,R5>
	RSB

;
; ===========================================================
;  HELP_BROWSER -- headless stub.
;
;  SCCONF links SETUP.OBJ for the pure INIT_DECKS / INIT_MAP
;  routines that ENG_NEWGAME calls (SC-5-12).  SETUP.MAR's
;  interactive party-setup screen ALSO calls G^HELP_BROWSER
;  (the SMG$ help browser in HELP.MAR), which the headless
;  replayer deliberately does not link -- pulling HELP.OBJ in
;  would cascade the whole screen-management stack into a
;  headless image.  The replayer never enters interactive
;  setup, so this stub only satisfies the linker; it is never
;  reached at run time.  (When INIT_DECKS / INIT_MAP migrate to
;  the pure ENGINE layer, SCCONF can drop SETUP.OBJ and this
;  stub with it.)
; ===========================================================
;
	.ENTRY	HELP_BROWSER, ^M<>
	RET

	.END	SCCONF
