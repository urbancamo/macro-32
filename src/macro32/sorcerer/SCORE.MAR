	.TITLE	SCORE  End-game scoring + score screen
	.IDENT	/V0.1/

;++
; SCORE.MAR
;
;   Final-score calculation + the post-game screen.
;
;   Score formula (per the rule book):
;
;     score = 0
;     for each party slot whose PS is original (0) or ally (1):
;         s = creature_points[PC[slot]]
;         if PK[slot] > 0:                ; dragon-slayer
;             s *= 2
;         score += s
;         for each treasure carried by that slot:
;             score += treasure_points[item]
;     if SCAVE_STATE_SK:                  ; sorcerer killed
;         score += 30
;     score -= 30 * SCAVE_STATE_NC        ; per-curse penalty
;     score = max(0, score)
;
;   When the party is wiped (SCAVE_STATE_GS == DEAD) we set the
;   score to 0 unconditionally and paint the perished screen.
;
; Public:
;
;   CALCULATE_SCORE  --  fills SCAVE_STATE_SC.
;
;   SHOW_SCORE       --  full-screen end-game display, blocks on any
;                        key.  Renders one of three variants based
;                        on SCAVE_STATE_GS:
;                          ESCAPED  -> "ESCAPED THE CAVE!"  + breakdown
;                          DEAD     -> "YOUR PARTY HAS PERISHED"
;                          QUIT     -> "You abandoned the cave."
;--

	$SSDEF
	$DSCDEF

	.EXTRN	SMG$PUT_CHARS
	.EXTRN	SYS$FAO

	.EXTRN	BEGIN_BATCH
	.EXTRN	END_BATCH
	.EXTRN	ERASE_MAIN
	.EXTRN	PAINT_CENTERED
	.EXTRN	READ_KEY
	.EXTRN	SCAVE_UI_DSP_MAP

	.EXTRN	SCAVE_STATE_GS
	.EXTRN	SCAVE_STATE_SC
	.EXTRN	SCAVE_STATE_NC
	.EXTRN	SCAVE_STATE_SK
	.EXTRN	SCAVE_STATE_TN

	.EXTRN	SCAVE_PARTY_NP
	.EXTRN	SCAVE_PARTY_PC
	.EXTRN	SCAVE_PARTY_PS
	.EXTRN	SCAVE_PARTY_PK
	.EXTRN	SCAVE_PARTY_PT

	.EXTRN	SCAVE_DATA_CR_PTS
	.EXTRN	SCAVE_DATA_TR_PTS
	.EXTRN	SCAVE_DATA_TR_WT
	.EXTRN	SCAVE_DATA_TR_NAME_PTR


	; SCAVE$_GS_* mirrors of STATE.MAR (file-local; see
	; feedback_macro32_local_constants memory).
	SCAVE$_GS_PLAYING = 0
	SCAVE$_GS_ESCAPED = 1
	SCAVE$_GS_DEAD    = 2
	SCAVE$_GS_QUIT    = 3

	; Per-creature treasure backing slots -- MUST match STATE.MAR's
	; SCAVE$_TREAS_PER (file-local `=` constants don't cross modules).
	SCAVE$_TREAS_PER = 20


	.PSECT	SCAVE_SCORE_DATA, NOEXE, WRT, LONG

	.ALIGN	LONG
DSC_HDR_ESCAPED:	.ASCID	/** ESCAPED THE CAVE **/
DSC_HDR_DEAD:		.ASCID	/** YOUR PARTY HAS PERISHED **/
DSC_HDR_QUIT:		.ASCID	/-- You abandoned the cave --/

DSC_PROMPT_END:		.ASCID	/(press any key to end)/

DSC_LINE_TURN:		.ASCID	/Turns played: !UL/
DSC_LINE_CR:		.ASCID	/Creatures + treasure: !UL pts/
DSC_LINE_DRAGON:	.ASCID	/Dragon-slayer doubles: applied in line above/
DSC_LINE_SORC:		.ASCID	/Sorcerer slain bonus: !UL/
DSC_LINE_CURSE:		.ASCID	/Curse penalty: -!UL  (!UL curse(s))/
DSC_LINE_TOTAL:		.ASCID	/====  FINAL SCORE: !UL  ====/

; -- "you failed" loot summary (DEAD screen) --
DSC_LOOT_HDR:		.ASCID	/Treasure carried by the fallen party (all lost):/
DSC_LOOT_ART:		.ASCID	/Artifacts: /
DSC_LOOT_NONE:		.ASCID	/(none)/
DSC_LOOT_HEAVY_FAO:	.ASCID	/Heavy treasure: !UL item(s), !UL kg/

	.ALIGN	LONG
COL_LEFT:	.LONG	6			; left margin for the loot section
LOOT_KG:	.LONG	0			; total heavy-treasure weight carried
LOOT_HEAVY_N:	.LONG	0			; count of heavy items carried
LOOT_ART_N:	.LONG	0			; count of artifacts carried
LOOT_COL:	.LONG	0			; running column for the artifact list
LOOT_ROW:	.LONG	0			; current row for the artifact list

	.ALIGN	LONG
LINE_BUF:	.BLKB	120
	.ALIGN	LONG
LINE_DSC:	.WORD	120
		.BYTE	DSC$K_DTYPE_T
		.BYTE	DSC$K_CLASS_S
		.ADDRESS LINE_BUF

	.ALIGN	LONG
ROW_TMP:	.BLKL	1
FAO_OUTLEN:	.BLKW	1
	.ALIGN	LONG

;
; Working scratch.
;
SUB_CR:		.LONG	0			; subtotal: creatures+treasure
SUB_SORC:	.LONG	0
SUB_CURSE:	.LONG	0


	.PSECT	SCAVE_SCORE_CODE, EXE, NOWRT, LONG

;
; ===========================================================
;  CALCULATE_SCORE  --  no args.  Fills SCAVE_STATE_SC.
; ===========================================================
;
	.ENTRY	CALCULATE_SCORE, ^M<R2,R3,R4,R5,R6,R7>

	; Wipe -> 0.
	CMPL	SCAVE_STATE_GS, #SCAVE$_GS_DEAD
	BNEQ	1$
	CLRL	SCAVE_STATE_SC
	CLRL	SUB_CR
	CLRL	SUB_SORC
	CLRL	SUB_CURSE
	RET
1$:

	CLRL	R6				; running sum (creatures+treasure)
	CLRL	R5				; party slot
PSUM_LOOP:
	CMPL	R5, SCAVE_PARTY_NP
	BLSS	PSUM_BODY
	BRB	PSUM_DONE
PSUM_BODY:
	; Skip stoned / dead.
	MOVL	SCAVE_PARTY_PS[R5], R0
	CMPL	R0, #2				; STONE
	BLSS	PSUM_KEEP
	BRB	PSUM_NEXT
PSUM_KEEP:
	; Add creature_points[PC[slot]], doubled if dragon-slayer.
	MOVL	SCAVE_PARTY_PC[R5], R1
	MOVAB	SCAVE_DATA_CR_PTS, R2
	MOVL	(R2)[R1], R3			; R3 = points for this creature
	TSTL	SCAVE_PARTY_PK[R5]
	BEQL	2$
	ASHL	#1, R3, R3			; *= 2  (R3 = points * 2)
2$:
	ADDL2	R3, R6

	; Walk this creature's treasure slots (SCAVE$_TREAS_PER of them).
	MULL3	#SCAVE$_TREAS_PER, R5, R0	; offset = slot * stride
	MOVL	#SCAVE$_TREAS_PER, R7		; loop count
TS_LOOP:
	MOVL	SCAVE_PARTY_PT[R0], R1
	BLSS	TS_NEXT				; -1 = empty (signed compare)
	MOVAB	SCAVE_DATA_TR_PTS, R2
	ADDL2	(R2)[R1], R6
TS_NEXT:
	INCL	R0
	SOBGTR	R7, TS_LOOP
PSUM_NEXT:
	INCL	R5
	BRW	PSUM_LOOP

PSUM_DONE:
	MOVL	R6, SUB_CR

	; Sorcerer bonus.
	CLRL	R0
	TSTL	SCAVE_STATE_SK
	BEQL	3$
	MOVL	#30, R0
3$:
	MOVL	R0, SUB_SORC

	; Curse penalty: 30 * NC.
	MULL3	#30, SCAVE_STATE_NC, R0
	MOVL	R0, SUB_CURSE

	; total = SUB_CR + SUB_SORC - SUB_CURSE, clamped at 0.
	ADDL3	SUB_CR, SUB_SORC, R0
	SUBL2	SUB_CURSE, R0
	BGEQ	4$
	CLRL	R0
4$:
	MOVL	R0, SCAVE_STATE_SC

	MOVL	#SS$_NORMAL, R0
	RET


;
; ===========================================================
;  SHOW_SCORE  --  end-game screen.  Blocks on any key.
; ===========================================================
;
	.ENTRY	SHOW_SCORE, ^M<R2,R3,R4,R5,R6,R7,R8,R9>

	CALLS	#0, G^CALCULATE_SCORE

	CALLS	#0, G^BEGIN_BATCH
	CALLS	#0, G^ERASE_MAIN

	; Header chosen by SCAVE_STATE_GS.
	MOVAB	DSC_HDR_QUIT, R2
	CMPL	SCAVE_STATE_GS, #SCAVE$_GS_ESCAPED
	BNEQ	1$
	MOVAB	DSC_HDR_ESCAPED, R2
	BRB	2$
1$:	CMPL	SCAVE_STATE_GS, #SCAVE$_GS_DEAD
	BNEQ	2$
	MOVAB	DSC_HDR_DEAD, R2
2$:
	MOVL	#3, ROW_TMP
	PUSHAL	ROW_TMP
	PUSHL	R2
	CALLS	#2, G^PAINT_CENTERED

	; Body lines, only relevant if not QUIT.
	CMPL	SCAVE_STATE_GS, #SCAVE$_GS_QUIT
	BNEQ	3$
	BRW	SS_FOOTER
3$:
	; "Turns played: N"
	BSBW	PAINT_TURNS

	; On defeat, the score is 0 -- instead of the points breakdown,
	; show what the fallen party was carrying (artifacts + heavy
	; treasure), all of it lost with them.
	CMPL	SCAVE_STATE_GS, #SCAVE$_GS_DEAD
	BNEQ	6$
	BSBW	PAINT_DEAD_LOOT
	BSBW	PAINT_TOTAL_LINE
	BRW	SS_FOOTER
6$:
	; "Creatures + treasure: N pts"
	BSBW	PAINT_CR_LINE

	; "Sorcerer slain bonus: N"  -- only if SK
	TSTL	SCAVE_STATE_SK
	BEQL	4$
	BSBW	PAINT_SORC_LINE
4$:
	; "Curse penalty: -N (M curse(s))" -- only if NC > 0
	TSTL	SCAVE_STATE_NC
	BEQL	5$
	BSBW	PAINT_CURSE_LINE
5$:
	; Total
	BSBW	PAINT_TOTAL_LINE

SS_FOOTER:
	MOVL	#16, ROW_TMP
	PUSHAL	ROW_TMP
	PUSHAL	DSC_PROMPT_END
	CALLS	#2, G^PAINT_CENTERED

	CALLS	#0, G^END_BATCH
	CALLS	#0, G^READ_KEY

	MOVL	#SS$_NORMAL, R0
	RET


;
; -- per-line helpers ---------------------------------------
;

PAINT_TURNS:
	MOVW	#120, LINE_DSC
	$FAO_S	ctrstr=DSC_LINE_TURN, outlen=FAO_OUTLEN, outbuf=LINE_DSC, -
		p1=SCAVE_STATE_TN
	MOVW	FAO_OUTLEN, LINE_DSC
	MOVL	#6, ROW_TMP
	PUSHAL	ROW_TMP
	PUSHAL	LINE_DSC
	CALLS	#2, G^PAINT_CENTERED
	RSB

PAINT_CR_LINE:
	MOVW	#120, LINE_DSC
	$FAO_S	ctrstr=DSC_LINE_CR, outlen=FAO_OUTLEN, outbuf=LINE_DSC, -
		p1=SUB_CR
	MOVW	FAO_OUTLEN, LINE_DSC
	MOVL	#8, ROW_TMP
	PUSHAL	ROW_TMP
	PUSHAL	LINE_DSC
	CALLS	#2, G^PAINT_CENTERED
	RSB

PAINT_SORC_LINE:
	MOVW	#120, LINE_DSC
	$FAO_S	ctrstr=DSC_LINE_SORC, outlen=FAO_OUTLEN, outbuf=LINE_DSC, -
		p1=SUB_SORC
	MOVW	FAO_OUTLEN, LINE_DSC
	MOVL	#10, ROW_TMP
	PUSHAL	ROW_TMP
	PUSHAL	LINE_DSC
	CALLS	#2, G^PAINT_CENTERED
	RSB

PAINT_CURSE_LINE:
	MOVW	#120, LINE_DSC
	$FAO_S	ctrstr=DSC_LINE_CURSE, outlen=FAO_OUTLEN, outbuf=LINE_DSC, -
		p1=SUB_CURSE, p2=SCAVE_STATE_NC
	MOVW	FAO_OUTLEN, LINE_DSC
	MOVL	#11, ROW_TMP
	PUSHAL	ROW_TMP
	PUSHAL	LINE_DSC
	CALLS	#2, G^PAINT_CENTERED
	RSB

PAINT_TOTAL_LINE:
	MOVW	#120, LINE_DSC
	$FAO_S	ctrstr=DSC_LINE_TOTAL, outlen=FAO_OUTLEN, outbuf=LINE_DSC, -
		p1=SCAVE_STATE_SC
	MOVW	FAO_OUTLEN, LINE_DSC
	MOVL	#13, ROW_TMP
	PUSHAL	ROW_TMP
	PUSHAL	LINE_DSC
	CALLS	#2, G^PAINT_CENTERED
	RSB


;
; ===========================================================
;  PAINT_DEAD_LOOT  --  for the "you failed" screen: walk every party
;                       slot's pack and show what the fallen party was
;                       carrying -- each artifact by name, plus the total
;                       count and weight of heavy treasure.  All of it is
;                       lost with the party (the score is 0).
;
;  Uses R5-R9 (saved by SHOW_SCORE's entry mask).
; ===========================================================
;
PAINT_DEAD_LOOT:
	CLRL	LOOT_KG
	CLRL	LOOT_HEAVY_N
	CLRL	LOOT_ART_N
	MOVL	#9, LOOT_ROW			; artifact list rows 9..11
	MOVL	#17, LOOT_COL			; first name column (after the label)

	; Section header (centered, row 8).
	MOVL	#8, ROW_TMP
	PUSHAL	ROW_TMP
	PUSHAL	DSC_LOOT_HDR
	CALLS	#2, G^PAINT_CENTERED

	; "Artifacts: " label at (row 9, col 6).
	MOVL	#9, ROW_TMP
	PUSHAL	COL_LEFT
	PUSHAL	ROW_TMP
	PUSHAL	DSC_LOOT_ART
	PUSHAL	SCAVE_UI_DSP_MAP
	CALLS	#4, G^SMG$PUT_CHARS

	CLRL	R5				; party slot
PDL_PLOOP:
	CMPL	R5, SCAVE_PARTY_NP
	BGEQ	PDL_PDONE
	MULL3	#SCAVE$_TREAS_PER, R5, R6	; PT base index for this slot
	CLRL	R7				; k = 0..stride-1
PDL_TLOOP:
	CMPL	R7, #SCAVE$_TREAS_PER
	BGEQ	PDL_PNEXT
	ADDL3	R6, R7, R8
	MOVL	SCAVE_PARTY_PT[R8], R9		; treasure index, or -1
	BLSS	PDL_TINC			; empty slot
	MOVAB	SCAVE_DATA_TR_WT, R0
	MOVL	(R0)[R9], R1			; item weight
	BNEQ	PDL_HEAVY			; weight > 0 -> heavy treasure
	; artifact (weightless): list it by name
	BSBW	PAINT_ARTIFACT_NAME		; R9 = treasure index
	INCL	LOOT_ART_N
	BRB	PDL_TINC
PDL_HEAVY:
	ADDL2	R1, LOOT_KG			; sum kg
	INCL	LOOT_HEAVY_N
PDL_TINC:
	INCL	R7
	BRB	PDL_TLOOP
PDL_PNEXT:
	INCL	R5
	BRW	PDL_PLOOP
PDL_PDONE:
	; If no artifacts at all, mark the label "(none)".
	TSTL	LOOT_ART_N
	BNEQ	1$
	MOVL	#9, ROW_TMP
	MOVL	#17, LOOT_COL
	PUSHAL	LOOT_COL
	PUSHAL	ROW_TMP
	PUSHAL	DSC_LOOT_NONE
	PUSHAL	SCAVE_UI_DSP_MAP
	CALLS	#4, G^SMG$PUT_CHARS
1$:
	; Heavy-treasure total at (row 12, col 6).
	MOVW	#120, LINE_DSC
	$FAO_S	ctrstr=DSC_LOOT_HEAVY_FAO, outlen=FAO_OUTLEN, outbuf=LINE_DSC, -
		p1=LOOT_HEAVY_N, p2=LOOT_KG
	MOVW	FAO_OUTLEN, LINE_DSC
	MOVL	#12, ROW_TMP
	PUSHAL	COL_LEFT
	PUSHAL	ROW_TMP
	PUSHAL	LINE_DSC
	PUSHAL	SCAVE_UI_DSP_MAP
	CALLS	#4, G^SMG$PUT_CHARS
	RSB


;
; PAINT_ARTIFACT_NAME  --  R9 = treasure index.  Paint that treasure's
;   name at (LOOT_ROW, LOOT_COL), advancing LOOT_COL by the name length +
;   a gap; wrap to the next row near the right margin and stop after row
;   11.  Clobbers R0-R2 (R5-R9 preserved across the SMG$PUT_CHARS call).
;
PAINT_ARTIFACT_NAME:
	CMPL	LOOT_COL, #66			; near the right margin?
	BLSS	1$
	INCL	LOOT_ROW			; wrap to the next row
	MOVL	#8, LOOT_COL
1$:	CMPL	LOOT_ROW, #11
	BLEQ	2$
	RSB					; out of room -- drop the rest
2$:	MOVL	SCAVE_DATA_TR_NAME_PTR[R9], R2	; name descriptor address
	MOVL	LOOT_ROW, ROW_TMP
	PUSHAL	LOOT_COL
	PUSHAL	ROW_TMP
	PUSHL	R2
	PUSHAL	SCAVE_UI_DSP_MAP
	CALLS	#4, G^SMG$PUT_CHARS
	MOVZWL	(R2), R0			; name length (descriptor word 0)
	ADDL2	R0, LOOT_COL
	INCL	LOOT_COL			; one-space gap before the next
	RSB

	.END
