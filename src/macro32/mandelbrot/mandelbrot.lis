                                     01B4   129
                                     01B4   130 ; Row buffer (sized to MAX_W). The RAB's RBF points here; RSZ is patched
                                     01B4   131 ; to the actual WIDTH once the user has been prompted.
                           000003B4  01B4   132 ROW_BUF:	.BLKB	MAX_W
                                     03B4   133
                                     03B4   134 ; Shade ramp. 10 chars: lightest (fast escape) -> darkest (slow escape).
                                     03B4   135 ; Points in the set use INSET_CHAR.
      25 23 2A 2B 3D 2D 3A 2C 2E 20  03B4   136 GRADIENT:	.ASCII	/ .,:-=+*#%/
                           00000040  03BE   137 INSET_CHAR	= ^A/@/
                                     03BE   138
                                     03BE   139 ; RMS control blocks -- must be longword aligned.
                                     03BE   140 	.ALIGN	LONG
                                     03C0   141 OUT_FAB:	$FAB	FNM=<SYS$DISK:[]MANDELBROT.TXT>,-
                                     03C0   142 			FAC=PUT,-
                                     03C0   143 			ORG=SEQ,-
                                     03C0   144 			RFM=VAR,-
                                     03C0   145 			RAT=CR,-
                                     03C0   146 			MRS=MAX_W
                                     0410   147
                                     0410   148 	.ALIGN	LONG
                                     0410   149 OUT_RAB:	$RAB	FAB=OUT_FAB,-
                                     0410   150 			RAC=SEQ,-
                                     0410   151 			RBF=ROW_BUF,-
                                     0410   152 			RSZ=MAX_W
