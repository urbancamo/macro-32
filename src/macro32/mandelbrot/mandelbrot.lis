                            53   D6  01C6   324 	INCL	R3
              00000000'EF   53   D1  01C8   325 	CMPL	R3, WIDTH
                            92   19  01CF   326 	BLSS	COL_LOOP
                                     01D1   327
                                     01D1   328 ; End of row: write the buffer as one RMS record.
                                     01D1   329 	$PUT	RAB=OUT_RAB
                         2D 50   E9  01DE   330 	BLBC	R0, PUT_ERR			; $PUT failed -> close + return
                                     01E1   331
                            52   D6  01E1   332 	INCL	R2
              00000004'EF   52   D1  01E3   333 	CMPL	R2, HEIGHT
                                     01EA   334 ; Invert + BRW: row body exceeds byte-branch range.
                            03   18  01EA   335 	BGEQ	DONE
                          FF61   31  01EC   336 	BRW	ROW_LOOP
                                     01EF   337
                                     01EF   338 ; -----------------------------------------------------------------------
                                     01EF   339 ; Normal exit: close the file, then tell the user where the output went.
                                     01EF   340 ; If $CLOSE fails we skip the "Done" message and return its error status.
                                     01EF   341 ; -----------------------------------------------------------------------
                                     01EF   342 DONE:	$CLOSE	FAB=OUT_FAB
                         01 50   E8  01FC   343 	BLBS	R0, 70$
                                 04  01FF   344 	RET
                   000000F9'EF   DF  0200   345 70$:	PUSHAL	DONE_MSG
              00000000'GF   01   FB  0206   346 	CALLS	#1, G^LIB$PUT_OUTPUT
                                 04  020D   347 	RET
