                                     0454   153
                                     0454   154 ;
                                     0454   155 ; Code.
                                     0454   156 ;
                                 00000000   157 	.PSECT	MANDEL_CODE, EXE, NOWRT, LONG
                                     0000   158
                                     0000   159 ;
                                     0000   160 ; MANDELBROT -- program entry point.
                                     0000   161 ;
                                     0000   162 ;   Integer registers:
                                     0000   163 ;     R2 = current row
                                     0000   164 ;     R3 = current column
                                     0000   165 ;     R4 = iteration counter
                                     0000   166 ;   F_floating registers:
                                     0000   167 ;     R5 = Zr    R6 = Zi      (current z)
                                     0000   168 ;     R7 = Cr    R8 = Ci      (current c)
                                     0000   169 ;     R9 = Zr^2  R10 = Zi^2
                                     0000   170 ;     R11 = scratch / Zi_new buffer
                                     0000   171 ;
                               0FFC  0000   172 	.ENTRY	MANDELBROT, ^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
                                     0002   173
                                     0002   174 ; -----------------------------------------------------------------------
                                     0002   175 ; Banner. We don't check R0 -- if SYS$OUTPUT is broken everything else
                                     0002   176 ; will fail anyway.
                                     0002   177 ; -----------------------------------------------------------------------
                   00000080'EF   DF  0002   178 	PUSHAL	INTRO_1
              00000000'GF   01   FB  0008   179 	CALLS	#1, G^LIB$PUT_OUTPUT
                   000000AF'EF   DF  000F   180 	PUSHAL	INTRO_2
              00000000'GF   01   FB  0015   181 	CALLS	#1, G^LIB$PUT_OUTPUT
                                     001C   182
                                     001C   183 ; -----------------------------------------------------------------------
                                     001C   184 ; Phase 1: prompt for width, parse, validate.
                                     001C   185 ; -----------------------------------------------------------------------
                   00000074'EF   3F  001C   186 	PUSHAW	IN_LEN
                   00000128'EF   DF  0022   187 	PUSHAL	PROMPT_W
                   00000078'EF   DF  0028   188 	PUSHAL	IN_DESC
              00000000'GF   03   FB  002E   189 	CALLS	#3, G^LIB$GET_INPUT
                         01 50   E8  0035   190 	BLBS	R0, 10$
                                 04  0038   191 	RET
                                     0039   192 10$:
     00000078'EF   00000074'EF   B0  0039   193 	MOVW	IN_LEN, IN_DESC			; shrink to actual bytes
                   00000000'EF   DF  0044   194 	PUSHAL	WIDTH
                   00000078'EF   DF  004A   195 	PUSHAL	IN_DESC
              00000000'GF   02   FB  0050   196 	CALLS	#2, G^OTS$CVT_TU_L
                         01 50   E8  0057   197 	BLBS	R0, 20$
                                 04  005A   198 	RET
                                     005B   199 20$:
                   00000000'EF   D5  005B   200 	TSTL	WIDTH
                            03   14  0061   201 	BGTR	21$
                          01BB   31  0063   202 	BRW	WIDTH_ERR
     00000200 8F   00000000'EF   D1  0066   203 21$:	CMPL	WIDTH, #MAX_W
                            03   15  0071   204 	BLEQ	22$
                          01AB   31  0073   205 	BRW	WIDTH_ERR
                                     0076   206 22$:
                                     0076   207
                                     0076   208 ; -----------------------------------------------------------------------
                                     0076   209 ; Phase 2: prompt for height, parse, validate.
MANDELBROT                      ASCII Mandelbrot (user W x H) written to 22-APR-2026 17:01:26  VAX MACRO V5.4-3            Page   5
V1.2                                                                     22-APR-2026 17:01:24  [MSW.CLAUDE]MANDELBROT.MAR;6      (1)

                                     0076   210 ; -----------------------------------------------------------------------
         00000078'EF   0050 8F   B0  0076   211 	MOVW	#IN_MAX, IN_DESC		; restore descriptor size
                   00000074'EF   3F  007F   212 	PUSHAW	IN_LEN
                   00000141'EF   DF  0085   213 	PUSHAL	PROMPT_H
                   00000078'EF   DF  008B   214 	PUSHAL	IN_DESC
              00000000'GF   03   FB  0091   215 	CALLS	#3, G^LIB$GET_INPUT
                         01 50   E8  0098   216 	BLBS	R0, 30$
                                 04  009B   217 	RET
                                     009C   218 30$:
     00000078'EF   00000074'EF   B0  009C   219 	MOVW	IN_LEN, IN_DESC
                   00000004'EF   DF  00A7   220 	PUSHAL	HEIGHT
                   00000078'EF   DF  00AD   221 	PUSHAL	IN_DESC
              00000000'GF   02   FB  00B3   222 	CALLS	#2, G^OTS$CVT_TU_L
                         01 50   E8  00BA   223 	BLBS	R0, 40$
                                 04  00BD   224 	RET
                                     00BE   225 40$:
                   00000004'EF   D5  00BE   226 	TSTL	HEIGHT
                            03   14  00C4   227 	BGTR	41$
                          0169   31  00C6   228 	BRW	HEIGHT_ERR
     00001000 8F   00000004'EF   D1  00C9   229 41$:	CMPL	HEIGHT, #MAX_H
                            03   15  00D4   230 	BLEQ	42$
                          0159   31  00D6   231 	BRW	HEIGHT_ERR
                                     00D9   232 42$:
                                     00D9   233
                                     00D9   234 ; -----------------------------------------------------------------------
                                     00D9   235 ; Phase 3: create and open MANDELBROT.TXT, patch RSZ to actual WIDTH.
                                     00D9   236 ; -----------------------------------------------------------------------
                                     00D9   237 	$CREATE	FAB=OUT_FAB
                         01 50   E8  00E6   238 	BLBS	R0, 50$
                                 04  00E9   239 	RET					; no file to clean up on failure
                                     00EA   240 50$:
                                     00EA   241 	$CONNECT RAB=OUT_RAB
                         13 50   E8  00F7   242 	BLBS	R0, 60$
                                     00FA   243 ; $CONNECT failed after a successful $CREATE -- close + return R0.
                            50   DD  00FA   244 	PUSHL	R0
                                     00FC   245 	$CLOSE	FAB=OUT_FAB
                            50 8ED0  0109   246 	POPL	R0
                                 04  010C   247 	RET
                                     010D   248 60$:
                                     010D   249 ; Patch RAB.RSZ with actual WIDTH (low word of WIDTH is the byte count).
     00000432'EF   00000000'EF   B0  010D   250 	MOVW	WIDTH, OUT_RAB+RAB$W_RSZ
                                     0118   251
                                     0118   252 ; -----------------------------------------------------------------------
                                     0118   253 ; Phase 4: compute DX, DY.
                                     0118   254 ; -----------------------------------------------------------------------
55   0000000C'EF   00000008'EF   43  0118   255 	SUBF3	REAL_MIN, REAL_MAX, R5		; R5 = 3.5
              56   00000000'EF   4E  0124   256 	CVTLF	WIDTH, R6
         0000001C'EF   55   56   47  012B   257 	DIVF3	R6, R5, DX			; DX = 3.5 / WIDTH
                                     0133   258
55   00000014'EF   00000010'EF   43  0133   259 	SUBF3	IMAG_MIN, IMAG_MAX, R5		; R5 = 2.4
              56   00000004'EF   4E  013F   260 	CVTLF	HEIGHT, R6
         00000020'EF   55   56   47  0146   261 	DIVF3	R6, R5, DY			; DY = 2.4 / HEIGHT
                                     014E   262
                            52   D4  014E   263 	CLRL	R2				; row = 0
                                     0150   264
                                     0150   265 ; -----------------------------------------------------------------------
                                     0150   266 ; Outer row loop.
MANDELBROT                      ASCII Mandelbrot (user W x H) written to 22-APR-2026 17:01:26  VAX MACRO V5.4-3            Page   6
V1.2                                                                     22-APR-2026 17:01:24  [MSW.CLAUDE]MANDELBROT.MAR;6      (1)

                                     0150   267 ; -----------------------------------------------------------------------
                                     0150   268 ROW_LOOP:
                                     0150   269 ; Ci = IMAG_MIN + row * DY
                       58   52   4E  0150   270 	CVTLF	R2, R8
              58   00000020'EF   44  0153   271 	MULF2	DY, R8
              58   00000010'EF   40  015A   272 	ADDF2	IMAG_MIN, R8
                                     0161   273
                            53   D4  0161   274 	CLRL	R3				; col = 0
                                     0163   275
                                     0163   276 ; -----------------------------------------------------------------------
                                     0163   277 ; Inner column loop.
                                     0163   278 ; -----------------------------------------------------------------------
                                     0163   279 COL_LOOP:
                                     0163   280 ; Cr = REAL_MIN + col * DX
                       57   53   4E  0163   281 	CVTLF	R3, R7
              57   0000001C'EF   44  0166   282 	MULF2	DX, R7
              57   00000008'EF   40  016D   283 	ADDF2	REAL_MIN, R7
                                     0174   284
                                     0174   285 ; Reset orbit.
                            55   D4  0174   286 	CLRF	R5				; Zr = 0
                            56   D4  0176   287 	CLRF	R6				; Zi = 0
                            54   D4  0178   288 	CLRL	R4				; iter = 0
                                     017A   289
                                     017A   290 ; -----------------------------------------------------------------------
                                     017A   291 ; Escape-time iteration.
                                     017A   292 ; -----------------------------------------------------------------------
                                     017A   293 ITER_LOOP:
                  59   55   55   45  017A   294 	MULF3	R5, R5, R9			; R9  = Zr^2
                  5A   56   56   45  017E   295 	MULF3	R6, R6, R10			; R10 = Zi^2
                  5B   5A   59   41  0182   296 	ADDF3	R9, R10, R11			; R11 = |z|^2
              00000018'EF   5B   51  0186   297 	CMPF	R11, FOURF
                            26   14  018D   298 	BGTR	ESCAPED
                                     018F   299
                                     018F   300 ; z_new = z*z + c -- Zi first (needs old Zr,Zi), then Zr.
                  5B   56   55   45  018F   301 	MULF3	R5, R6, R11			; R11 = Zr*Zi
                       5B   5B   40  0193   302 	ADDF2	R11, R11			; R11 = 2*Zr*Zi
                       5B   58   40  0196   303 	ADDF2	R8, R11				; R11 = 2*Zr*Zi + Ci = Zi_new
                                     0199   304
                  55   59   5A   43  0199   305 	SUBF3	R10, R9, R5			; R5 = Zr^2 - Zi^2
                       55   57   40  019D   306 	ADDF2	R7, R5				; R5 = Zr^2 - Zi^2 + Cr = Zr_new
                                     01A0   307
                       56   5B   50  01A0   308 	MOVF	R11, R6				; R6 = Zi_new
                                     01A3   309
                            54   D6  01A3   310 	INCL	R4
                       1E   54   D1  01A5   311 	CMPL	R4, #MAX_ITER
                            D0   19  01A8   312 	BLSS	ITER_LOOP
                                     01AA   313
                                     01AA   314 ; Fell through -> point is in the set.
         000001B4'EF43   40 8F   90  01AA   315 	MOVB	#INSET_CHAR, ROW_BUF[R3]
                            11   11  01B3   316 	BRB	NEXT_COL
                                     01B5   317
                                     01B5   318 ; Escape -> pick from shade ramp.
                                     01B5   319 ESCAPED:
                  51   54   03   C7  01B5   320 	DIVL3	#3, R4, R1			; R1 = iter / 3 in [0..9]
 000001B4'EF43   000003B4'EF41   90  01B9   321 	MOVB	GRADIENT[R1], ROW_BUF[R3]
                                     01C6   322
                                     01C6   323 NEXT_COL:
MANDELBROT                      ASCII Mandelbrot (user W x H) written to 22-APR-2026 17:01:26  VAX MACRO V5.4-3            Page   7
