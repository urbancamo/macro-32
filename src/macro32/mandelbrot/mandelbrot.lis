V1.2                                                                     22-APR-2026 17:01:24  [MSW.CLAUDE]MANDELBROT.MAR;6      (1)

                                     0000     1 	.TITLE	MANDELBROT	ASCII Mandelbrot (user W x H) written to MANDELBROT.TXT
                                     0000     2 	.IDENT	/V1.2/
                                     0000     3
                                     0000     4 ;++
                                     0000     5 ; MANDELBROT.MAR
                                     0000     6 ;
                                     0000     7 ;   Prompts the user for a width (columns) and height (rows) on
                                     0000     8 ;   SYS$INPUT, then renders the Mandelbrot set as ASCII art at that
                                     0000     9 ;   resolution into the file MANDELBROT.TXT in the current default
                                     0000    10 ;   directory -- one record (one line) per row.
                                     0000    11 ;
                                     0000    12 ;   Width  is capped at MAX_W (512)  -- the static row buffer size.
                                     0000    13 ;   Height is capped at MAX_H (4096) -- a sanity bound.
                                     0000    14 ;
                                     0000    15 ;   Prompts and any error messages still go to SYS$OUTPUT so the user
                                     0000    16 ;   can interact; only the rendered image is written to the file.
                                     0000    17 ;
                                     0000    18 ;   On invalid input (non-digit, zero, or out-of-range) a short error
                                     0000    19 ;   message is printed and the image exits with SS$_BADPARAM.
                                     0000    20 ;
                                     0000    21 ; Algorithm (unchanged):
                                     0000    22 ;
                                     0000    23 ;   For each pixel (col, row):
                                     0000    24 ;       c = Cr + Ci*i      ; linear map from pixel coords to
                                     0000    25 ;                           ; REAL_MIN..REAL_MAX / IMAG_MIN..IMAG_MAX
                                     0000    26 ;       z = 0; iter = 0
                                     0000    27 ;       while iter < MAX_ITER:
                                     0000    28 ;           if |z|^2 > 4: break       ; escaped
                                     0000    29 ;           z = z*z + c
                                     0000    30 ;           iter += 1
                                     0000    31 ;       plot GRADIENT[iter/3]  or INSET_CHAR if iter == MAX_ITER
                                     0000    32 ;
                                     0000    33 ;   Inline squaring:
                                     0000    34 ;       Zr_new = Zr^2 - Zi^2 + Cr
                                     0000    35 ;       Zi_new = 2*Zr*Zi   + Ci
                                     0000    36 ;   Escape test compares squared magnitude (Zr^2 + Zi^2 > 4) -- no sqrt.
                                     0000    37 ;
                                     0000    38 ; Output file characteristics:
                                     0000    39 ;   FNM = SYS$DISK:[]MANDELBROT.TXT   (current default directory)
                                     0000    40 ;   FAC = PUT
                                     0000    41 ;   ORG = SEQ
                                     0000    42 ;   RFM = VAR        (variable-length records)
                                     0000    43 ;   RAT = CR         (carriage-return carriage control -- one record = one line)
                                     0000    44 ;   MRS = MAX_W      (max record size; actual RSZ patched at runtime)
                                     0000    45 ;
                                     0000    46 ; Error handling:
                                     0000    47 ;   - LIB$GET_INPUT / OTS$CVT_TU_L failure -> RET with R0.
                                     0000    48 ;   - WIDTH / HEIGHT out of bounds -> message + SS$_BADPARAM.
                                     0000    49 ;   - $CREATE failure -> RET with R0 (no cleanup needed).
                                     0000    50 ;   - $CONNECT / $PUT failure -> best-effort $CLOSE, return R0.
                                     0000    51 ;
                                     0000    52 ; References consulted:
                                     0000    53 ;   reference/VAX-VMS-731/vax-macro-ref-2001.md
                                     0000    54 ;       Chapter 9 -- ADDF2/3, SUBF3, MULF3, DIVF3, CMPF, CLRF, CVTLF,
                                     0000    55 ;                    DIVL3, MOVW, conditional branches.
                                     0000    56 ;       Chapter 5 -- indexed addressing label[Rn] scaled by operand size.
                                     0000    57 ;   reference/VAX-VMS-731/rtl-lib.md
MANDELBROT                      ASCII Mandelbrot (user W x H) written to 22-APR-2026 17:01:26  VAX MACRO V5.4-3            Page   2
V1.2                                                                     22-APR-2026 17:01:24  [MSW.CLAUDE]MANDELBROT.MAR;6      (1)

                                     0000    58 ;       LIB$GET_INPUT, LIB$PUT_OUTPUT.
                                     0000    59 ;   reference/VAX-VMS-731/rtl-ots.md
                                     0000    60 ;       OTS$CVT_TU_L.
                                     0000    61 ;   reference/VAX-VMS-731/rms-reference.md
                                     0000    62 ;       $FAB/$RAB keyword args; $CREATE/$CONNECT/$PUT/$CLOSE.
                                     0000    63 ;       RAB$W_RSZ field offset (set at runtime so one FAB/RAB serves
                                     0000    64 ;       any WIDTH up to MAX_W).
                                     0000    65 ;   reference/macro-made-easy/part-09-using-rms-from-macro.md
                                     0000    66 ;       RMS fundamentals, $FABDEF/$RABDEF.
                                     0000    67 ;
                                     0000    68 ; Build (on OpenVMS):
                                     0000    69 ;   $ MACRO MANDELBROT
                                     0000    70 ;   $ LINK MANDELBROT
                                     0000    71 ;   $ RUN MANDELBROT
                                     0000    72 ;   $ TYPE MANDELBROT.TXT
                                     0000    73 ;--
                                     0000    74
                           00000200  0000    75 	MAX_W		= 512			; row buffer limit
                           00001000  0000    76 	MAX_H		= 4096			; sanity limit on rows
                           0000001E  0000    77 	MAX_ITER	= 30			; must equal 3 * GRADIENT_LEN
                           0000000A  0000    78 	GRADIENT_LEN	= 10
                           00000050  0000    79 	IN_MAX		= 80
                                     0000    80
                                     0000    81 ;
                                     0000    82 ; Symbol macro includes.
                                     0000    83 ;
                                     0000    84 	$DSCDEF				; DSC$K_DTYPE_T, DSC$K_CLASS_S
                                     0000    85 	$SSDEF				; SS$_BADPARAM, SS$_NORMAL
                                     0000    86 	$FABDEF				; FAB$* symbols used by $FAB macro
                                     0000    87 	$RABDEF				; RAB$W_RSZ and friends
                                     0000    88
                                     0000    89 ;
                                     0000    90 ; Data.
                                     0000    91 ;
                                 00000000    92 	.PSECT	MANDEL_DATA, NOEXE, WRT, LONG
                                     0000    93
                                     0000    94 ; User-supplied grid dimensions (parsed from input).
                           00000000  0000    95 WIDTH:		.LONG	0
                           00000000  0004    96 HEIGHT:		.LONG	0
                                     0008    97
                                     0008    98 ; View window edges, F_floating.
                           0000C120  0008    99 REAL_MIN:	.F_FLOATING	-2.5
                           00004080  000C   100 REAL_MAX:	.F_FLOATING	 1.0
                           999AC099  0010   101 IMAG_MIN:	.F_FLOATING	-1.2
                           999A4099  0014   102 IMAG_MAX:	.F_FLOATING	 1.2
                           00004180  0018   103 FOURF:		.F_FLOATING	 4.0		; escape-radius squared
                                     001C   104
                                     001C   105 ; Per-pixel step sizes, derived at runtime from WIDTH / HEIGHT.
                           00000000  001C   106 DX:		.F_FLOATING	 0.0
                           00000000  0020   107 DY:		.F_FLOATING	 0.0
                                     0024   108
                                     0024   109 ; Input line buffer + descriptor + resultant-length word.
                           00000074  0024   110 IN_BUF:		.BLKB	IN_MAX
                               0000  0074   111 IN_LEN:		.WORD	0
                                     0076   112
                                     0076   113 	.ALIGN	LONG
                               0050  0078   114 IN_DESC:	.WORD	IN_MAX
